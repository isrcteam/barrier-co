{%- liquid
  assign s = section.settings
  assign pt = s['padding-block-start'] | divided_by: 16.0
  assign pb = s['padding-block-end'] | divided_by: 16.0
  if s.same_padding_mobile
    assign pt_mobile = pt
    assign pb_mobile = pb
  else
    assign pt_mobile = s['padding-block-start-mobile'] | divided_by: 16.0
    assign pb_mobile = s['padding-block-end-mobile'] | divided_by: 16.0
  endif
  assign columns = s.columns | default: 2
  assign heading_tag = s.heading_tag | default: 'h2'
  assign item_tag = 'h3'
  if heading_tag == 'p'
    assign item_tag = 'p'
  endif
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div
  {% if s.anchor_id != blank %}
    id="{{ s.anchor_id | handle }}"
  {% endif %}
  class="feature-grid color-custom-{{ section.id }}"
  style="--section-pt: {{ pt }}rem; --section-pb: {{ pb }}rem; --section-pt-mobile: {{ pt_mobile }}rem; --section-pb-mobile: {{ pb_mobile }}rem; --feature-grid-columns: {{ columns }};"
>
  <div class="feature-grid__inner">
    {%- if s.heading != blank -%}
      <{{ heading_tag }} class="feature-grid__heading type-h1">{{ s.heading | escape }}</{{ heading_tag }}>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="feature-grid__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign position = forloop.index0 | modulo: columns
            assign item_classes = 'feature-grid__item'
            if position == 0
              assign item_classes = item_classes | append: ' feature-grid__item--row-start'
            endif
            if forloop.index0 < columns
              assign item_classes = item_classes | append: ' feature-grid__item--first-row'
            endif
          -%}
          <li class="{{ item_classes }}" {{ block.shopify_attributes }}>
            <span class="feature-grid__icon">
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 240
                  | image_tag: widths: '80, 160, 240', sizes: '5rem', loading: 'lazy', class: 'feature-grid__image', alt: ''
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'feature-grid__image feature-grid__placeholder' }}
              {%- endif -%}
            </span>
            <div class="feature-grid__body">
              {%- if block.settings.title != blank -%}
                <{{ item_tag }} class="feature-grid__title type-card-label">{{ block.settings.title | escape | newline_to_br }}</{{ item_tag }}>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="feature-grid__text type-body-large">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .feature-grid {
    padding-block: var(--section-pt-mobile) var(--section-pb-mobile);
    padding-inline: var(--layout-gutter);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .feature-grid__inner {
    display: grid;
    gap: calc(var(--space-60) - var(--space-4));
    max-width: calc(var(--space-112) * 11 + var(--space-80));
    margin-inline: auto;
  }

  .feature-grid__heading {
    margin: 0;
    text-align: center;
    text-transform: uppercase;
  }

  .feature-grid__list {
    display: grid;
    gap: calc(var(--space-30) + var(--space-2));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature-grid__item {
    display: grid;
    grid-template-columns: calc(var(--space-60) - var(--space-4)) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-16);
    padding-block-end: calc(var(--space-30) + var(--space-2));
    border-block-end: var(--border-hairline) solid var(--color-accent-bar);
  }

  .feature-grid__item:last-child {
    padding-block-end: 0;
    border-block-end: 0;
  }

  .feature-grid__icon {
    display: block;
  }

  .feature-grid__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .feature-grid__placeholder {
    background: var(--color-foreground);
    opacity: var(--opacity-brand-subtle);
  }

  .feature-grid__body {
    display: grid;
    gap: var(--space-12);
  }

  .feature-grid__title {
    margin: 0;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .feature-grid .feature-grid__title {
    font-size: var(--type-body-large-size);
  }

  .feature-grid .feature-grid__text {
    font-size: var(--type-body-size);
    line-height: 1.4;
  }

  .feature-grid__text > * {
    margin: 0;
  }

  .feature-grid__text > * + * {
    margin-block-start: var(--space-12);
  }

  @media screen and (min-width: 990px) {
    .feature-grid {
      padding-block: var(--section-pt) var(--section-pb);
    }

    .feature-grid__inner {
      gap: var(--space-60);
    }

    .feature-grid__list {
      grid-template-columns: repeat(var(--feature-grid-columns), minmax(0, 1fr));
      gap: 0;
    }

    .feature-grid__item,
    .feature-grid__item:last-child {
      grid-template-columns: calc(var(--space-80) - var(--space-4)) minmax(0, calc(var(--space-112) * 4 + var(--space-60) - var(--space-8)));
      gap: var(--space-24);
      padding: var(--space-30) var(--space-40) calc(var(--space-30) + var(--space-4));
      border-block-start: var(--border-hairline) solid var(--color-accent-bar);
      border-block-end: 0;
      border-inline-start: var(--border-hairline) solid var(--color-accent-bar);
    }

    .feature-grid__item--first-row {
      border-block-start: 0;
    }

    .feature-grid__item--row-start {
      padding-inline-start: 0;
      border-inline-start: 0;
    }

    .feature-grid__body {
      gap: calc(var(--space-16) + var(--space-2));
    }

    .feature-grid .feature-grid__title {
      font-size: var(--type-card-label-size);
    }

    .feature-grid .feature-grid__text {
      font-size: var(--type-body-large-size);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.feature_grid",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 9,
  "blocks": [
    {
      "type": "item",
      "name": "t:names.feature_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:settings.icon"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "t:settings.title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.text"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.feature_grid_heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "options": [
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns_desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:settings.anchor_id",
      "info": "t:info.section_anchor"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "same_padding_mobile",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.feature_grid",
      "category": "t:categories.storytelling",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {}
        },
        "item_2": {
          "type": "item",
          "settings": {}
        },
        "item_3": {
          "type": "item",
          "settings": {}
        },
        "item_4": {
          "type": "item",
          "settings": {}
        }
      },
      "block_order": [
        "item_1",
        "item_2",
        "item_3",
        "item_4"
      ]
    }
  ]
}
{% endschema %}
