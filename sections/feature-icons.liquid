{%- liquid
  assign pt = section.settings['padding-block-start'] | divided_by: 16.0
  assign pb = section.settings['padding-block-end'] | divided_by: 16.0
  if section.settings.same_padding_mobile
    assign pt_mobile = pt
    assign pb_mobile = pb
  else
    assign pt_mobile = section.settings['padding-block-start-mobile'] | divided_by: 16.0
    assign pb_mobile = section.settings['padding-block-end-mobile'] | divided_by: 16.0
  endif
-%}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div
  class="feature-icons color-custom-{{ section.id }}"
  style="--section-pt: {{ pt }}rem; --section-pb: {{ pb }}rem; --section-pt-mobile: {{ pt_mobile }}rem; --section-pb-mobile: {{ pb_mobile }}rem; --feature-columns: {{ section.settings.columns }}; --feature-icon-height: {{ section.settings.icon_height | default: 110 | divided_by: 16.0 }}rem;"
>
  {%- if section.settings.heading != blank or section.settings.text != blank -%}
    <div class="feature-icons__header">
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag | default: 'h2' }} class="feature-icons__heading type-h1">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag | default: 'h2' }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="feature-icons__text type-body-large">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <ul class="feature-icons__list" role="list">
      {%- for block in section.blocks -%}
        <li class="feature-icons__item" {{ block.shopify_attributes }}>
          <span class="feature-icons__icon">
            {%- if block.settings.icon != blank -%}
              {%- liquid
                assign own_height = ''
                if block.settings.height > 0
                  assign own_height = block.settings.height | divided_by: 16.0 | prepend: '--feature-icon-own-height: ' | append: 'rem;'
                endif
              -%}
              {{
                block.settings.icon
                | image_url: width: 330
                | image_tag:
                  widths: '110, 220, 330',
                  sizes: '7rem',
                  loading: 'lazy',
                  class: 'feature-icons__image',
                  style: own_height,
                  alt: ''
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'feature-icons__image feature-icons__image--placeholder' }}
            {%- endif -%}
          </span>
          {%- if block.settings.caption != blank -%}
            {%- assign caption_html = block.settings.caption | escape | newline_to_br -%}
            <p class="feature-icons__caption type-body{% if caption_html contains '<br' %} feature-icons__caption--lines{% endif %}">{{ caption_html }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .feature-icons {
    padding-block: var(--section-pt-mobile) var(--section-pb-mobile);
    padding-inline: var(--layout-gutter);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .feature-icons__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-30) var(--space-10);
    max-width: calc(var(--space-112) * 10 + var(--space-30));
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .feature-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--space-16) + var(--space-2));
    text-align: center;
  }

  .feature-icons__header {
    display: grid;
    justify-items: center;
    gap: var(--space-16);
    margin-block-end: var(--space-40);
    text-align: center;
  }

  .feature-icons__heading {
    margin: 0;
    text-transform: uppercase;
  }

  .feature-icons .feature-icons__text {
    font-size: var(--type-body-size);
  }

  .feature-icons__text > * {
    margin: 0;
  }

  .feature-icons__icon {
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 100%;
    height: var(--feature-icon-height);
  }

  .feature-icons__image {
    display: block;
    width: auto;
    max-width: min(100%, var(--feature-icon-height));
    height: var(--feature-icon-own-height, 100%);
    object-fit: contain;
  }

  .feature-icons__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .feature-icons__image--placeholder {
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-foreground) calc(var(--opacity-brand-subtle) * 100%), transparent);
  }

  .feature-icons__caption {
    max-width: calc(var(--space-80) * 2 + var(--space-8));
    margin: 0;
    font-size: var(--type-body-large-size);
    text-wrap: balance;
  }

  .feature-icons__caption--lines {
    max-width: none;
    white-space: nowrap;
  }

  @media screen and (min-width: 990px) {
    .feature-icons__image {
      max-width: 100%;
    }

    .feature-icons {
      padding-block: var(--section-pt) var(--section-pb);
    }

    .feature-icons__list {
      grid-template-columns: repeat(var(--feature-columns), minmax(0, 1fr));
      column-gap: calc(var(--space-86) + var(--space-4));
    }

    .feature-icons__caption {
      font-size: var(--type-body-size);
    }

    .feature-icons__item:last-child:nth-child(odd) {
      grid-column: auto;
    }

    .feature-icons__header {
      margin-block-end: var(--space-60);
    }

    .feature-icons .feature-icons__text {
      max-width: calc(var(--space-112) * 4 + var(--space-14));
      font-size: var(--type-body-large-size);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.feature_icons",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "t:names.feature_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:settings.icon",
          "info": "t:info.feature_icon"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "t:settings.caption"
        },
        {
          "type": "range",
          "id": "height",
          "label": "t:settings.icon_height_own",
          "info": "t:info.icon_height_own",
          "min": 0,
          "max": 160,
          "step": 2,
          "unit": "px",
          "default": 0
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "options": [
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "icon_height",
      "label": "t:settings.icon_height",
      "min": 40,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 110
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "same_padding_mobile",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.feature_icons",
      "category": "t:categories.storytelling",
      "settings": {
        "columns": 4
      },
      "blocks": {
        "item_hydration": {
          "type": "item",
          "settings": {
            "caption": "Deep Skin Hydration in 30 Minutes"
          }
        },
        "item_dryness": {
          "type": "item",
          "settings": {
            "caption": "Helps Reduce Dryness"
          }
        },
        "item_smoother": {
          "type": "item",
          "settings": {
            "caption": "Supports Smoother Looking Skin"
          }
        },
        "item_texture": {
          "type": "item",
          "settings": {
            "caption": "Skin Texture Improvement"
          }
        }
      },
      "block_order": [
        "item_hydration",
        "item_dryness",
        "item_smoother",
        "item_texture"
      ]
    }
  ]
}
{% endschema %}
