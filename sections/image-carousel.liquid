      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 30,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.image_carousel_routine",
      "category": "t:categories.storytelling",
      "settings": {
        "heading": "Your whole routine.\nOne cloth.",
        "heading_tag": "h2",
        "middle_card": "offset",
        "show_side_bars": true,
        "caption_alignment": "center",
        "caption_size": "type-body-small"
      },
      "blocks": {
        "card_cleanse": {
          "type": "card",
          "settings": {
            "card_label": "Cleanse",
            "caption": "Lifts away sweat, impurities and buildup without stripping the skin."
          }
        },
        "card_hydrate": {
          "type": "card",
          "settings": {
            "card_label": "Hydrate",
            "caption": "Replenishes moisture for lasting, comfortable hydration."
          }
        },
        "card_protect": {
          "type": "card",
          "settings": {
            "card_label": "Protect",
            "caption": "Supports the skin barrier to help lock in moisture and protect against dryness."
          }
        }
      },
      "block_order": [
        "card_cleanse",
        "card_hydrate",
        "card_protect"
      ]
    },
    {
      "name": "t:names.image_carousel_lifestyle",
      "category": "t:categories.storytelling",
      "settings": {
        "heading": "Body care.\nWherever life happens.",
        "heading_tag": "h2",
        "subheading": "Post-workout. In-flight. Beach to dinner. On the go.",
        "middle_card": "tall",
        "show_side_bars": true,
        "caption_alignment": "left",
        "caption_size": "type-body"
      },
      "blocks": {
        "card_shell": {
          "type": "card",
          "settings": {}
        },
        "card_travel": {
          "type": "card",
          "settings": {}
        },
        "card_pack": {
          "type": "card",
          "settings": {}
        }
      },
      "block_order": [
        "card_shell",
        "card_travel",
        "card_pack"
      ]
    }
  ]
}
{% endschema %}
