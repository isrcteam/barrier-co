{%- liquid
  assign slide_count = section.blocks.size
  assign layout = section.settings.middle_card
  assign heading_tag = section.settings.heading_tag

  assign pt = section.settings['padding-block-start'] | divided_by: 16.0
  assign pb = section.settings['padding-block-end'] | divided_by: 16.0
  if section.settings.same_padding_mobile
    assign pt_mobile = pt
    assign pb_mobile = pb
  else
    assign pt_mobile = section.settings['padding-block-start-mobile'] | divided_by: 16.0
    assign pb_mobile = section.settings['padding-block-end-mobile'] | divided_by: 16.0
  endif

  if layout == 'tall'
    assign side_sizes = '(min-width: 990px) 30vw, 100vw'
    assign middle_sizes = '(min-width: 990px) 40vw, 100vw'
  else
    assign side_sizes = '(min-width: 990px) 33vw, 100vw'
    assign middle_sizes = side_sizes
  endif
-%}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div
  class="image-carousel image-carousel--{{ layout }}{% if section.blocks.size <= 3 %} image-carousel--fits{% endif %} image-carousel--caption-{{ section.settings.caption_alignment }}{% if section.settings.show_side_bars %} image-carousel--bars{% endif %} color-custom-{{ section.id }}"
  style="--section-pt: {{ pt }}rem; --section-pb: {{ pb }}rem; --section-pt-mobile: {{ pt_mobile }}rem; --section-pb-mobile: {{ pb_mobile }}rem;"
>
  <div class="image-carousel__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="image-carousel__header">
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="image-carousel__heading type-h1">
            {{- section.settings.heading | escape | newline_to_br -}}
          </{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="image-carousel__subheading type-body-large">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if slide_count > 0 -%}
      {%- capture slides -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign position = forloop.index0 | modulo: 3
            assign slide_class = 'image-carousel__slide'
            assign image_sizes = side_sizes
            if position == 1
              assign slide_class = 'image-carousel__slide image-carousel__slide--middle'
              assign image_sizes = middle_sizes
            endif
          -%}
          {%- capture card -%}
            <div class="image-carousel__card" {{ block.shopify_attributes }}>
              <div class="image-carousel__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1500
                    | image_tag:
                      widths: '375, 550, 750, 1100, 1500',
                      sizes: image_sizes,
                      loading: 'lazy',
                      class: 'image-carousel__image'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'image-carousel__image image-carousel__image--placeholder' }}
                {%- endif -%}
                {%- if block.settings.card_label != blank -%}
                  <p class="image-carousel__label type-card-label">{{ block.settings.card_label | escape }}</p>
                {%- endif -%}
                {%- if block.settings.product != blank -%}
                  <div class="image-carousel__spotlight">
                    {% render 'product-spotlight',
                      product: block.settings.product,
                      style: 'glass',
                      button_label: block.settings.button_label,
                      price_label: block.settings.price_label
                    %}
                  </div>
                {%- endif -%}
              </div>
              {%- if block.settings.caption != blank -%}
                <p class="image-carousel__caption {{ section.settings.caption_size }}">{{ block.settings.caption | escape }}</p>
              {%- endif -%}
            </div>
          {%- endcapture -%}
          {% render 'slideshow-slide', index: forloop.index0, children: card, class: slide_class %}
        {%- endfor -%}
      {%- endcapture -%}

      {%- capture controls -%}
        {%- if slide_count > 1 -%}
          {% render 'slideshow-controls',
            style: 'dots',
            item_count: slide_count,
            show_arrows: true,
            icon_style: 'arrow',
            pagination_position: 'center',
            class: 'image-carousel__controls'
          %}
        {%- endif -%}
      {%- endcapture -%}

      <div class="image-carousel__stage">
        {%- if section.settings.show_side_bars -%}
          <span class="image-carousel__bar" aria-hidden="true"></span>
        {%- endif -%}
        {%- liquid
          assign start_slide_index = section.settings.start_slide | default: 1 | minus: 1
          if start_slide_index >= slide_count
            assign start_slide_index = 0
          endif
        -%}
        {% render 'slideshow',
          ref: 'imageCarousel',
          class: 'image-carousel__slideshow',
          slides: slides,
          slide_count: slide_count,
          controls: controls,
          slide_position: 'top',
          infinite: false,
          initial_slide: start_slide_index
        %}
        {%- if section.settings.show_side_bars -%}
          <span class="image-carousel__bar" aria-hidden="true"></span>
        {%- endif -%}

        {%- if start_slide_index > 0 -%}
          {%- comment -%} Horizon marks the starting slide current but leaves the mobile track at 0; centre it once loaded {%- endcomment -%}
          <script type="module">
            const start = {{ start_slide_index }};
            const run = () => {
              const slideshow = document.querySelector('#shopify-section-{{ section.id }} slideshow-component');
              const scroller = slideshow?.querySelector('slideshow-slides');
              if (!slideshow || !scroller || scroller.scrollWidth <= scroller.clientWidth + 1) return;
              const slide = scroller.querySelectorAll('slideshow-slide')[start];
              if (!slide || scroller.scrollLeft > 0) return;
              // Horizon already counts this slide as current, so select() is a no-op; centre it directly
              const track = scroller.getBoundingClientRect();
              const card = slide.getBoundingClientRect();
              scroller.scrollTo({ left: card.left + card.width / 2 - (track.left + track.width / 2), behavior: 'instant' });
            };
            if (document.readyState === 'complete') requestAnimationFrame(run);
            else window.addEventListener('load', () => requestAnimationFrame(run), { once: true });
          </script>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .image-carousel {
    padding-block: var(--section-pt-mobile) var(--section-pb-mobile);
    padding-inline: var(--layout-gutter);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .image-carousel__inner {
    display: grid;
    gap: var(--space-24);
    max-width: var(--layout-content-width);
    margin-inline: auto;
    container-type: inline-size;
  }

  .image-carousel__header {
    display: grid;
    gap: var(--space-24);
    text-align: center;
  }

  .image-carousel__heading {
    margin: 0;
    text-transform: uppercase;
  }

  .image-carousel__subheading {
    margin: 0;
  }

  .image-carousel__stage {
    --stage-pad: calc(var(--space-6) * 0);
    --bar-width: var(--icon-bar-mobile);
    --bar-height: calc(var(--space-60) + var(--space-10));
    --card-gap: var(--space-10);
    --bars-total: calc(var(--bar-width) * 0);
    --track: calc(100cqi - 2 * var(--stage-pad) - var(--bars-total));

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    padding-inline: var(--stage-pad);
  }

  .image-carousel--bars .image-carousel__stage {
    --stage-pad: var(--space-6);
    --bars-total: calc(2 * (var(--bar-width) + var(--space-12)));

    grid-template-columns: var(--bar-width) minmax(0, 1fr) var(--bar-width);
    column-gap: var(--space-12);
  }

  .image-carousel__bar {
    display: block;
    width: var(--bar-width);
    height: var(--bar-height);
    margin-block-start: calc((var(--track) - var(--bar-height)) / 2);
    background: var(--color-accent-bar);
  }

  .image-carousel__slideshow {
    --track: 100cqi;
    --slideshow-gap: var(--card-gap);

    gap: var(--space-4);
    min-width: 0;
  }

  .image-carousel .image-carousel__slide {
    width: 100%;
    scroll-snap-align: start;
  }

  .image-carousel__card {
    display: grid;
    gap: var(--space-12);
  }

  .image-carousel__media {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    aspect-ratio: 1;
    overflow: hidden;
    padding: var(--space-16) var(--space-10);
  }

  .image-carousel--tall .image-carousel__slide--middle .image-carousel__media {
    aspect-ratio: 397 / 458;
  }

  .image-carousel__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-carousel__image--placeholder {
    background: var(--color-background);
  }

  .image-carousel__label {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-10);
    margin: 0;
    color: var(--color-on-media);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .image-carousel__label::before,
  .image-carousel__label::after {
    content: '';
    display: block;
    width: calc(var(--space-4) + 0.0625rem);
    height: calc(var(--space-14) + 0.0625rem);
    background: currentColor;
  }

  .image-carousel__spotlight {
    position: absolute;
    inset-inline: var(--space-6);
    inset-block-end: var(--space-6);
  }

  .image-carousel__caption {
    margin: 0;
    color: var(--color-caption);
    text-align: center;
  }

  /* Mobile: 40 from the 6px dot to the section edge; the 24 tap row adds 9 below it */
  .image-carousel__controls {
    justify-content: center;
    margin-block-end: calc((var(--space-24) - var(--space-6)) / -2);
    mix-blend-mode: normal;
  }

  .image-carousel .image-carousel__controls .slideshow-controls__arrows {
    display: none;
  }

  .image-carousel .image-carousel__controls .slideshow-controls__dots {
    margin-inline: auto;
    gap: 0;
    padding: 0;
    border-radius: var(--radius-none);
  }

  .image-carousel .image-carousel__controls .slideshow-controls__dots button {
    --size: var(--space-6);
    border-radius: var(--radius-none);
  }

  .image-carousel .image-carousel__controls .slideshow-controls__dots button::after {
    border-radius: var(--radius-none);
    box-shadow: none;
    background-color: var(--color-accent-bar);
    opacity: var(--opacity-brand-inactive);
  }

  .image-carousel .image-carousel__controls .slideshow-controls__dots button[aria-selected='true']::after {
    opacity: 1;
  }

  .image-carousel .image-carousel__controls .slideshow-control {
    color: var(--color-foreground);
  }

  .image-carousel .image-carousel__controls .slideshow-control:focus-visible {
    outline: var(--border-strong) solid var(--color-foreground);
    box-shadow: var(--effect-focus-ring);
  }

  @media screen and (min-width: 990px) {
    .image-carousel {
      padding-block: var(--section-pt) var(--section-pb);
    }

    .image-carousel__inner {
      gap: var(--space-30);
    }

    .image-carousel__slideshow {
      gap: var(--space-30);
    }

    .image-carousel__stage {
      --bar-width: var(--icon-bar-desktop);
      --side-ratio: 0.2816;
      --middle-ratio: 0.2816;
      --side-drop-ratio: 0;
      --middle-drop-ratio: 0;
    }

    .image-carousel--bars .image-carousel__stage {
      grid-template-columns: var(--bar-width) minmax(0, 1fr) var(--bar-width);
      column-gap: 0;
      padding-inline: 0;
    }

    .image-carousel--tall .image-carousel__stage {
      --bar-width: calc(var(--icon-bar-desktop) - var(--space-2));
      --side-ratio: 0.224;
      --middle-ratio: 0.3005;
      --side-drop-ratio: 0.0855;
    }

    .image-carousel--offset .image-carousel__stage {
      --middle-drop-ratio: 0.0757;
    }

    .image-carousel__bar {
      height: calc((100cqi - 2 * var(--bar-width)) * var(--side-ratio));
      margin-block-start: calc((100cqi - 2 * var(--bar-width)) * var(--side-drop-ratio));
    }

    .image-carousel .image-carousel__slide {
      flex: none;
      width: calc(100cqi * var(--side-ratio));
      margin-block-start: calc(100cqi * var(--side-drop-ratio));
    }

    .image-carousel .image-carousel__slide--middle {
      width: calc(100cqi * var(--middle-ratio));
      margin-block-start: calc(100cqi * var(--middle-drop-ratio));
    }

    .image-carousel--fits .image-carousel__slideshow {
      --slideshow-gap: 0;
    }

    .image-carousel--fits slideshow-slides {
      justify-content: space-evenly;
      gap: 0;
    }

    .image-carousel__card {
      gap: var(--space-8);
    }

    .image-carousel__media {
      padding: var(--space-30) var(--space-10);
    }

    .image-carousel__spotlight {
      inset-inline: var(--space-12);
      inset-block-end: var(--space-10);
    }

    .image-carousel__caption {
      max-width: calc(var(--space-112) * 2 + var(--space-80));
      justify-self: center;
    }

    .image-carousel--caption-left .image-carousel__caption {
      justify-self: start;
      text-align: start;
    }

    .image-carousel__controls {
      justify-content: space-between;
      min-block-size: 0;
      margin-block-end: 0;
    }

    .image-carousel__label::before,
    .image-carousel__label::after {
      height: calc(var(--space-16) + 0.0625rem);
    }

    .image-carousel__caption {
      margin-block-start: var(--space-4);
    }

    .image-carousel .image-carousel__controls .slideshow-controls__arrows {
      display: flex;
      height: auto;
    }

    .image-carousel--bars .image-carousel__controls {
      margin-inline: calc(var(--bar-width) * -1);
    }

    /* Figma's arrow row is 34: the 14 glyph with 10 above and below */
    .image-carousel .image-carousel__controls .slideshow-control {
      height: auto;
      min-block-size: 0;
      padding: var(--space-10) 0;
    }

    .image-carousel .image-carousel__controls .slideshow-controls__dots {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-carousel slideshow-slides {
      scroll-behavior: auto;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .image-carousel .image-carousel__slide {
      width: calc((100% - var(--card-gap)) / 2);
    }
  }

  /* Figma mobile lifestyle subheading is 18/1.3 (body-large is 16 on mobile elsewhere) */
  @media screen and (max-width: 989px) {
    .image-carousel__subheading {
      font-size: calc(var(--space-16) + var(--space-2));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.image_carousel",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "card",
      "name": "t:names.card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "card_label",
          "label": "t:settings.label"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "t:settings.caption"
        },
        {
          "type": "header",
          "content": "t:content.product_overlay"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:settings.product"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "t:settings.price_label",
          "info": "t:info.price_label",
          "default": "Starts from [price]"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:settings.button_label",
          "default": "Shop now"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "middle_card",
      "label": "t:settings.middle_card",
      "info": "t:info.middle_card",
      "options": [
        {
          "value": "even",
          "label": "t:options.even"
        },
        {
          "value": "offset",
          "label": "t:options.offset"
        },
        {
          "value": "tall",
          "label": "t:options.tall"
        }
      ],
      "default": "offset"
    },
    {
      "type": "checkbox",
      "id": "show_side_bars",
      "label": "t:settings.show_side_bars",
      "default": true
    },
    {
      "type": "range",
      "id": "start_slide",
      "label": "t:settings.start_slide",
      "info": "t:info.start_slide",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "select",
      "id": "caption_alignment",
      "label": "t:settings.caption_alignment",
      "info": "t:info.caption_alignment",
      "options": [
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "left",
          "label": "t:options.left"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "caption_size",
      "label": "t:settings.caption_size",
      "options": [
        {
          "value": "type-body-small",
          "label": "t:options.small"
        },
        {
          "value": "type-body",
          "label": "t:options.medium"
        }
      ],
      "default": "type-body-small"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "same_padding_mobile",
      "label": "t:settings.same_at_mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 30,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
