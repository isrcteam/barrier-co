{%- liquid
  assign s = section.settings
  assign pt = s['padding-block-start'] | divided_by: 16.0
  assign pb = s['padding-block-end'] | divided_by: 16.0
  if s.same_padding_mobile
    assign pt_mobile = pt
    assign pb_mobile = pb
  else
    assign pt_mobile = s['padding-block-start-mobile'] | divided_by: 16.0
    assign pb_mobile = s['padding-block-end-mobile'] | divided_by: 16.0
  endif
  assign heading_tag = s.heading_tag | default: 'h2'
  assign step_tag = 'h3'
  if heading_tag == 'p'
    assign step_tag = 'p'
  endif
  assign steps = section.blocks | where: 'type', 'step'
  assign active = s.active_steps
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

{%- if s.animate_steps and steps.size > 0 -%}
  <script src="{{ 'step-timeline.js' | asset_url }}" type="module" fetchpriority="low"></script>
{%- endif -%}

<step-timeline
  {% if s.anchor_id != blank %}
    id="{{ s.anchor_id | handle }}"
  {% endif %}
  class="step-timeline{% if s.image == blank %} step-timeline--no-image{% endif %} color-custom-{{ section.id }}"
  style="--section-pt: {{ pt }}rem; --section-pb: {{ pb }}rem; --section-pt-mobile: {{ pt_mobile }}rem; --section-pb-mobile: {{ pb_mobile }}rem;"
>
  <div class="step-timeline__inner">
    {%- if s.image != blank -%}
      <div class="step-timeline__media">
        {{
          s.image
          | image_url: width: 1100
          | image_tag: widths: '390, 750, 1100', sizes: '(min-width: 990px) 27vw, 100vw', loading: 'lazy', class: 'step-timeline__image'
        }}
      </div>
    {%- endif -%}

    {%- if s.eyebrow != blank or s.heading != blank or s.text != blank -%}
      <div class="step-timeline__header">
        {%- if s.eyebrow != blank -%}
          <p class="step-timeline__eyebrow type-eyebrow-small">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <{{ heading_tag }} class="step-timeline__heading type-h1">{{ s.heading | escape }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="step-timeline__text type-body-large">{{ s.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if steps.size > 0 -%}
      <ol class="step-timeline__steps" role="list">
        {%- for block in steps -%}
          {%- liquid
            assign step_classes = 'step-timeline__step'
            if active > 0 and forloop.index > active
              assign step_classes = step_classes | append: ' step-timeline__step--upcoming'
            endif
            if active > 0 and forloop.index >= active
              assign step_classes = step_classes | append: ' step-timeline__step--before-upcoming'
            endif
          -%}
          <li class="{{ step_classes }}" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <p class="step-timeline__label type-eyebrow-small">{{ block.settings.label | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <{{ step_tag }} class="step-timeline__title type-card-label">
                {%- if block.settings.title_link != blank -%}
                  <a href="{{ block.settings.title_link }}" class="step-timeline__title-link">{{ block.settings.title | escape }}</a>
                {%- else -%}
                  {{ block.settings.title | escape }}
                {%- endif -%}
              </{{ step_tag }}>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="step-timeline__body type-body-large">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="step-timeline__link">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</step-timeline>

{% stylesheet %}
  .step-timeline {
    --step-dot: var(--space-14);
    --step-rail-gap: var(--space-24);

    display: block;
    padding-block: var(--section-pt-mobile) var(--section-pb-mobile);
    padding-inline: var(--layout-gutter);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .step-timeline__inner {
    display: grid;
    gap: var(--space-40);
    max-width: var(--layout-content-width);
    margin-inline: auto;
  }

  .step-timeline__media {
    overflow: hidden;
  }

  .step-timeline__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 358 / 432;
    object-fit: cover;
  }

  .step-timeline__header {
    display: grid;
    justify-items: center;
    gap: var(--space-16);
    text-align: center;
  }

  .step-timeline__eyebrow,
  .step-timeline__label {
    margin: 0;
    color: var(--color-accent-bar);
    text-transform: uppercase;
  }

  .step-timeline :is(.step-timeline__eyebrow, .step-timeline__label, .step-timeline__text) {
    font-size: var(--type-body-small-size);
  }

  .step-timeline__heading {
    margin: 0;
    text-transform: uppercase;
  }

  .step-timeline__text {
    max-width: calc(var(--space-112) * 5 + var(--space-40));
  }

  .step-timeline__text > *,
  .step-timeline__body > * {
    margin: 0;
  }

  .step-timeline__steps {
    position: relative;
    display: grid;
    gap: calc(var(--space-30) + var(--space-2));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step-timeline__step {
    position: relative;
    display: grid;
    gap: var(--space-16);
    justify-items: start;
    padding-inline-start: calc(var(--step-dot) + var(--step-rail-gap));
  }

  .step-timeline__step::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: var(--step-dot);
    block-size: var(--step-dot);
    border-radius: var(--radius-full);
    background: currentColor;
  }

  .step-timeline__step:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-block: var(--step-dot) calc((var(--space-30) + var(--space-2)) * -1);
    inset-inline-start: calc((var(--step-dot) - var(--border-strong) - 0.0625rem) / 2);
    border-inline-start: calc(var(--border-strong) + 0.0625rem) solid currentColor;
  }

  .step-timeline__step--before-upcoming:not(:last-child)::after {
    border-inline-start-style: dashed;
    opacity: var(--opacity-brand-subtle);
  }

  .step-timeline__step--upcoming {
    opacity: var(--opacity-brand-faded);
  }

  .step-timeline__step--upcoming::before {
    opacity: calc(var(--opacity-brand-subtle) / var(--opacity-brand-faded));
  }

  .step-timeline__title {
    margin: 0;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .step-timeline__steps[data-animate] .step-timeline__step,
  .step-timeline__steps[data-animate] .step-timeline__step::before {
    transition:
      opacity var(--duration-slow) var(--easing-standard),
      scale var(--duration-slow) var(--easing-standard);
  }

  .step-timeline__steps[data-animate] .step-timeline__step:not(:last-child)::after {
    border-inline-start-style: dashed;
    opacity: var(--opacity-brand-subtle);
  }

  .step-timeline__steps[data-animate] .step-timeline__step:not(.is-reached) {
    opacity: var(--opacity-brand-faded);
  }

  .step-timeline__steps[data-animate] .step-timeline__step:not(.is-reached)::before {
    opacity: calc(var(--opacity-brand-subtle) / var(--opacity-brand-faded));
    scale: 0.8;
  }

  .step-timeline__steps[data-animate] .step-timeline__step.is-reached,
  .step-timeline__steps[data-animate] .step-timeline__step.is-reached::before {
    opacity: 1;
  }

  .step-timeline__steps[data-animate]::before {
    content: '';
    position: absolute;
    inset-block-start: calc(var(--step-dot) / 2);
    inset-inline-start: calc((var(--step-dot) - var(--border-strong) - 0.0625rem) / 2);
    inline-size: calc(var(--border-strong) + 0.0625rem);
    block-size: calc(var(--step-rail-length, 0rem) * var(--step-progress, 0));
    background: currentColor;
  }

  .step-timeline .step-timeline__title {
    font-size: calc(var(--type-card-label-size) + 0.125rem);
  }

  .step-timeline__title-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: var(--border-strong);
    text-underline-offset: var(--space-4);
  }

  .step-timeline__body a,
  .step-timeline__link {
    color: inherit;
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-underline-offset: var(--space-4);
  }

  .step-timeline__link {
    font-size: var(--type-body-large-size);
    text-transform: uppercase;
  }

  :is(.step-timeline__title-link, .step-timeline__link, .step-timeline__body a):hover {
    opacity: var(--opacity-brand-hover);
  }

  @media screen and (min-width: 990px) {
    .step-timeline {
      --step-rail-gap: var(--space-40);

      padding-block: var(--section-pt) var(--section-pb);
    }

    .step-timeline :is(.step-timeline__eyebrow, .step-timeline__label) {
      font-size: var(--type-eyebrow-small-size);
    }

    .step-timeline .step-timeline__text {
      font-size: calc(var(--type-body-large-size) + var(--space-2));
    }

    .step-timeline .step-timeline__title {
      font-size: var(--type-card-label-size);
    }

    .step-timeline__inner {
      grid-template-columns: minmax(0, calc(var(--space-112) * 4 + var(--space-6) - 0.0625rem)) minmax(0, calc(var(--space-112) * 3 + var(--space-40) + var(--space-4)));
      grid-template-areas:
        'header header'
        'steps media';
      justify-content: center;
      column-gap: var(--space-40);
      row-gap: var(--space-40);
    }

    .step-timeline--no-image .step-timeline__inner {
      grid-template-columns: minmax(0, calc(var(--space-112) * 4 + var(--space-6) - 0.0625rem));
      grid-template-areas:
        'header'
        'steps';
    }

    .step-timeline__header {
      grid-area: header;
    }

    .step-timeline__steps {
      grid-area: steps;
      align-self: start;
      margin-block-start: var(--space-40);
      gap: calc(var(--space-24) + var(--space-2));
    }

    .step-timeline__step:not(:last-child)::after {
      inset-block-end: calc((var(--space-24) + var(--space-2)) * -1);
    }

    .step-timeline__media {
      grid-area: media;
    }

    .step-timeline__image {
      aspect-ratio: 380 / 459;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.step_timeline",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 6,
  "blocks": [
    {
      "type": "step",
      "name": "t:names.step",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.title"
        },
        {
          "type": "url",
          "id": "title_link",
          "label": "t:settings.title_link"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:settings.link_label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.step_timeline_heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "options": [
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "range",
      "id": "active_steps",
      "label": "t:settings.active_steps",
      "info": "t:info.active_steps",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "animate_steps",
      "label": "t:settings.animate_steps",
      "info": "t:info.animate_steps",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:settings.anchor_id",
      "info": "t:info.section_anchor"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "same_padding_mobile",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.step_timeline",
      "category": "t:categories.storytelling",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {}
        },
        "step_2": {
          "type": "step",
          "settings": {}
        },
        "step_3": {
          "type": "step",
          "settings": {}
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3"
      ]
    }
  ]
}
{% endschema %}
