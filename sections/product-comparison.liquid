{%- liquid
  assign s = section.settings
  assign pt = s['padding-block-start'] | divided_by: 16.0
  assign pb = s['padding-block-end'] | divided_by: 16.0
  if s.same_padding_mobile
    assign pt_mobile = pt
    assign pb_mobile = pb
  else
    assign pt_mobile = s['padding-block-start-mobile'] | divided_by: 16.0
    assign pb_mobile = s['padding-block-end-mobile'] | divided_by: 16.0
  endif

  assign heading_tag = s.heading_tag | default: 'h2'
  assign column_tag = 'h3'
  if heading_tag == 'p'
    assign column_tag = 'p'
  endif

  assign columns = section.blocks | where: 'type', 'column'
  assign row_count = 0
  for column in columns
    assign column_points = column.settings.points | strip | newline_to_br | split: '<br />'
    if s.use_product_points and column.settings.product.metafields.custom.comparison_points.value.size > 0
      assign column_points = column.settings.product.metafields.custom.comparison_points.value
    endif
    if column_points.size > row_count
      assign row_count = column_points.size
    endif
  endfor

  assign card_scope = section.id | append: '-card'
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}
{%- if s.card_background_color != blank -%}
  {% render 'contrast-override', background_color: s.card_background_color, section_id: card_scope %}
{%- endif -%}

<div
  class="product-comparison color-custom-{{ section.id }}"
  style="--section-pt: {{ pt }}rem; --section-pb: {{ pb }}rem; --section-pt-mobile: {{ pt_mobile }}rem; --section-pb-mobile: {{ pb_mobile }}rem;"
>
  <div class="product-comparison__inner">
    {%- if s.heading != blank or s.text != blank -%}
      <div class="product-comparison__intro">
        {%- if s.heading != blank -%}
          <{{ heading_tag }} class="product-comparison__heading type-h1">{{ s.heading | escape | newline_to_br }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="product-comparison__text type-body-large">{{ s.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if columns.size > 0 -%}
      <ul
        class="comparison-table product-comparison__table"
        role="list"
        style="--comparison-columns: {{ columns.size }}; --comparison-rows: {{ row_count | at_least: 1 }};"
      >
        {%- for column in columns -%}
          {%- liquid
            assign column_product = column.settings.product
            assign points = column.settings.points | strip | newline_to_br | split: '<br />' | join: '|'
            if s.use_product_points and column_product.metafields.custom.comparison_points.value.size > 0
              assign points = column_product.metafields.custom.comparison_points.value | join: '|'
            endif
          -%}
          {% render 'comparison-column',
            product: column_product,
            title: column.settings.title,
            image: column.settings.image,
            points: points,
            rows: row_count,
            button_label: column.settings.button_label,
            featured: column.settings.featured,
            heading_tag: column_tag
          %}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.product != blank -%}
      <div class="product-comparison__product{% if s.card_background_color != blank %} color-custom-{{ card_scope }}{% endif %}">
        {% render 'product-spotlight',
          product: s.product,
          style: 'large',
          button_label: s.product_button_label,
          price_label: s.product_price_label,
          image_sizes: '8rem'
        %}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-comparison {
    padding-block: var(--section-pt-mobile) var(--section-pb-mobile);
    padding-inline: var(--layout-gutter);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .product-comparison__inner {
    display: grid;
    grid-template-areas:
      'intro'
      'table'
      'product';
    gap: var(--space-40);
    max-width: var(--layout-content-width);
    margin-inline: auto;
  }

  .product-comparison__intro {
    grid-area: intro;
    display: grid;
    gap: var(--space-16);
    text-align: center;
  }

  .product-comparison__heading {
    margin: 0;
    text-transform: uppercase;
  }

  .product-comparison__text > * {
    margin: 0;
  }

  .product-comparison__table {
    grid-area: table;
  }

  .product-comparison__product {
    grid-area: product;
  }

  .product-comparison__product .product-spotlight {
    width: 100%;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  @media screen and (min-width: 990px) {
    .product-comparison {
      padding-block: var(--section-pt) var(--section-pb);
    }

    .product-comparison__inner {
      grid-template-columns: minmax(0, max(calc(var(--space-112) * 4 + var(--space-40) + var(--space-4) + 0.0625rem), calc(var(--type-h1-size) * 8.2))) minmax(0, calc(var(--space-80) * 8));
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'intro table'
        'product table';
      justify-content: space-between;
      column-gap: var(--space-30);
      row-gap: calc(var(--space-40) + var(--space-10));
    }

    .product-comparison__intro {
      align-self: start;
      gap: var(--space-24);
      text-align: start;
    }

    .product-comparison__table {
      align-self: start;
    }

    .product-comparison__product {
      align-self: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_comparison",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "column",
      "name": "t:names.comparison_column",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:settings.product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.title",
          "info": "t:info.comparison_title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image",
          "info": "t:info.comparison_image"
        },
        {
          "type": "textarea",
          "id": "points",
          "label": "t:settings.comparison_points",
          "info": "t:info.comparison_points"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:settings.button_label"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "t:settings.comparison_featured",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Body care.\nWherever life happens."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "options": [
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "checkbox",
      "id": "use_product_points",
      "label": "t:settings.use_product_points",
      "info": "t:info.use_product_points",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.product_spotlight"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "text",
      "id": "product_price_label",
      "label": "t:settings.price_label",
      "info": "t:info.price_label",
      "default": "Starts From [price]"
    },
    {
      "type": "text",
      "id": "product_button_label",
      "label": "t:settings.button_label",
      "default": "Shop now"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "t:settings.card_background_color",
      "alpha": false,
      "default": "#F0ECE1"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "same_padding_mobile",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_comparison",
      "category": "t:categories.products",
      "settings": {
        "heading": "Body care.\nWherever life happens.",
        "text": "<p>Post-workout. In-flight. Beach to dinner. On the go.</p>"
      },
      "blocks": {
        "column_everyday": {
          "type": "column",
          "settings": {
            "title": "The 30. The everyday.",
            "points": "Designed for the post-shower routine\nUsed when the customer is already clean\nPrimarily associated with at-home body care\nFeels more like part of a daily routine",
            "button_label": "Shop the 30.",
            "featured": true
          }
        },
        "column_travel": {
          "type": "column",
          "settings": {
            "title": "The 8. Made to go where you go.",
            "points": "Designed for on-the-go body care\nUsed when the customer hasn’t showered yet\nMade for Post-workout, In-flight / travelling, Beach to dinner\nMade to go where you go",
            "button_label": "Shop the 8."
          }
        }
      },
      "block_order": [
        "column_everyday",
        "column_travel"
      ]
    }
  ]
}
{% endschema %}
