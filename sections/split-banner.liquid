{%- liquid
  assign s = section.settings
  assign tiles = section.blocks | where: 'type', 'tile'
  assign page_heading = s.heading | default: page.title
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div
  class="split-banner color-custom-{{ section.id }}"
  style="--split-banner-height: {{ s.height | divided_by: 16.0 }}rem; --split-banner-height-mobile: {{ s.height_mobile | divided_by: 16.0 }}rem; --split-banner-tiles: {{ tiles.size | at_least: 1 }};"
>
  {%- if section.index == 1 and page_heading != blank -%}
    <h1 class="visually-hidden">{{ page_heading | escape }}</h1>
  {%- endif -%}

  {%- if s.logo_text != blank -%}
    <a class="split-banner__logo" href="{{ s.logo_link | default: routes.root_url }}">
      <span class="split-banner__logo-text">{{ s.logo_text | escape }}</span>
    </a>
  {%- endif -%}

  {%- if tiles.size > 0 -%}
    <ul class="split-banner__tiles" role="list">
      {%- for block in tiles -%}
        {%- liquid
          assign image = block.settings.image
          assign image_mobile = image
          if block.settings.same_image_mobile == false and block.settings.image_mobile != blank
            assign image_mobile = block.settings.image_mobile
          endif
          assign loading = 'lazy'
          assign priority = 'auto'
          if section.index == 1
            assign loading = 'eager'
            assign priority = 'high'
          endif
        -%}
        <li class="split-banner__tile" {{ block.shopify_attributes }}>
          {%- if image != blank -%}
            <picture class="split-banner__media">
              {%- if image_mobile != image -%}
                <source
                  media="(min-width: 990px)"
                  srcset="{{ image | image_url: width: 750 }} 750w, {{ image | image_url: width: 1100 }} 1100w, {{ image | image_url: width: 1440 }} 1440w, {{ image | image_url: width: 1920 }} 1920w"
                  sizes="50vw"
                >
              {%- endif -%}
              {{
                image_mobile
                | image_url: width: 1920
                | image_tag:
                  widths: '390, 750, 1100, 1440, 1920',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  loading: loading,
                  fetchpriority: priority,
                  class: 'split-banner__image',
                  alt: image_mobile.alt
              }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'split-banner__image split-banner__placeholder' }}
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            {%- if block.settings.link != blank -%}
              <a class="split-banner__label" href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a>
            {%- else -%}
              <span class="split-banner__label">{{ block.settings.label | escape }}</span>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .split-banner {
    --split-banner-inset: calc(var(--space-60) + var(--space-4));

    position: relative;
    background: var(--color-background);
    color: var(--color-on-media);
  }

  .split-banner__tiles {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .split-banner__tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-block-size: var(--split-banner-height-mobile);
    padding: var(--space-30) var(--layout-gutter);
    overflow: hidden;
  }

  .split-banner__media,
  .split-banner__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split-banner__placeholder {
    background: var(--color-foreground);
    opacity: var(--opacity-brand-subtle);
  }

  .split-banner__label {
    position: relative;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-extrabold);
    font-size: var(--type-title-bold-size);
    line-height: 1.1;
    color: inherit;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: var(--border-hairline);
    text-underline-offset: var(--space-4);
  }

  .split-banner__label:hover {
    opacity: var(--opacity-brand-hover);
  }

  .split-banner__label:focus-visible,
  .split-banner__logo:focus-visible {
    outline: var(--border-hairline) solid currentColor;
    outline-offset: var(--space-4);
  }

  .split-banner__logo {
    position: absolute;
    inset-block-start: var(--space-20);
    inset-inline: 0;
    z-index: 1;
    display: flex;
    justify-content: center;
    inline-size: fit-content;
    margin-inline: auto;
    color: inherit;
    text-decoration: none;
  }

  .split-banner__logo-text {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-extrabold);
    font-size: calc(var(--space-40) + var(--space-6));
    line-height: 1;
    text-transform: uppercase;
  }

  .split-banner__logo-text::before,
  .split-banner__logo-text::after {
    content: '';
    flex: none;
    inline-size: var(--space-8);
    block-size: 1.13em;
    background: currentColor;
  }

  @media screen and (min-width: 990px) {
    .split-banner__tiles {
      grid-template-columns: repeat(var(--split-banner-tiles), minmax(0, 1fr));
    }

    .split-banner__tile {
      align-items: flex-start;
      justify-content: flex-start;
      min-block-size: var(--split-banner-height);
      padding: calc(var(--space-60) + var(--space-8) + 0.0625rem) var(--split-banner-inset);
    }

    .split-banner__tile:last-child:not(:first-child) {
      justify-content: flex-end;
    }

    .split-banner__label {
      font-size: var(--space-24);
    }

    .split-banner__logo {
      inset-block-start: calc(var(--space-40) + var(--space-10));
    }

    .split-banner__logo-text {
      gap: 0.43em;
      font-size: calc(var(--space-60) - var(--space-2));
    }

    .split-banner__logo-text::before,
    .split-banner__logo-text::after {
      inline-size: 0.155em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.split_banner",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 3,
  "blocks": [
    {
      "type": "tile",
      "name": "t:names.tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "checkbox",
          "id": "same_image_mobile",
          "label": "t:settings.same_at_mobile",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "t:settings.mobile_image",
          "visible_if": "{{ block.settings.same_image_mobile == false }}"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link",
          "info": "t:info.split_banner_link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "t:settings.logo_text",
      "info": "t:info.split_banner_logo",
      "default": "t:text_defaults.split_banner_logo"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "t:settings.logo_link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.hidden_heading",
      "info": "t:info.hidden_heading"
    },
    {
      "type": "range",
      "id": "height",
      "label": "t:settings.height",
      "min": 320,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 670
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "t:settings.height_mobile",
      "info": "t:info.split_banner_height_mobile",
      "min": 160,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    }
  ],
  "presets": [
    {
      "name": "t:names.split_banner",
      "category": "t:categories.banners",
      "blocks": {
        "tile_1": {
          "type": "tile",
          "settings": {
            "label": "t:text_defaults.split_banner_label_1",
            "link": "#materials"
          }
        },
        "tile_2": {
          "type": "tile",
          "settings": {
            "label": "t:text_defaults.split_banner_label_2",
            "link": "#mail-back"
          }
        }
      },
      "block_order": [
        "tile_1",
        "tile_2"
      ]
    }
  ]
}
{% endschema %}
