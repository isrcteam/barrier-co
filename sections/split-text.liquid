{%- liquid
  assign s = section.settings
  assign pt = s['padding-block-start'] | divided_by: 16.0
  assign pb = s['padding-block-end'] | divided_by: 16.0
  if s.same_padding_mobile
    assign pt_mobile = pt
    assign pb_mobile = pb
  else
    assign pt_mobile = s['padding-block-start-mobile'] | divided_by: 16.0
    assign pb_mobile = s['padding-block-end-mobile'] | divided_by: 16.0
  endif
  assign heading_tag = s.heading_tag | default: 'h2'
  assign heading_size = s.heading_size | default: 'h1'
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div
  {% if s.anchor_id != blank %}
    id="{{ s.anchor_id | handle }}"
  {% endif %}
  class="split-text color-custom-{{ section.id }}"
  style="--section-pt: {{ pt }}rem; --section-pb: {{ pb }}rem; --section-pt-mobile: {{ pt_mobile }}rem; --section-pb-mobile: {{ pb_mobile }}rem;"
>
  <div class="split-text__inner">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="split-text__titles">
        {%- if s.eyebrow != blank -%}
          <p class="split-text__eyebrow type-eyebrow-small">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <{{ heading_tag }} class="split-text__heading type-{{ heading_size }}">{{ s.heading | escape | newline_to_br }}</{{ heading_tag }}>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.text != blank -%}
      <div class="split-text__text type-body-large">{{ s.text }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .split-text {
    padding-block: var(--section-pt-mobile) var(--section-pb-mobile);
    padding-inline: var(--layout-gutter);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .split-text__inner {
    display: grid;
    gap: var(--space-40);
    max-width: var(--layout-content-width);
    margin-inline: auto;
    text-align: center;
  }

  .split-text__titles {
    display: grid;
    gap: var(--space-16);
  }

  .split-text__eyebrow {
    margin: 0;
    color: var(--color-accent-bar);
    text-transform: uppercase;
  }

  .split-text .split-text__eyebrow {
    font-size: var(--type-body-small-size);
  }

  .split-text__heading {
    margin: 0;
    text-transform: uppercase;
  }

  .split-text .split-text__heading.type-display {
    font-size: calc(var(--type-display-size) + var(--space-8));
    line-height: 1;
  }

  .split-text__text > * {
    margin: 0;
  }

  .split-text__text > * + * {
    margin-block-start: var(--space-16);
  }

  .split-text__text > p + p:not(:has(> a:only-child)) {
    margin-block-start: var(--space-40);
  }

  .split-text__text strong,
  .split-text__text b {
    font-weight: var(--font-weight-medium);
  }

  .split-text__text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: var(--space-4);
  }

  .split-text__text p:has(> a:only-child) > a {
    display: inline-block;
    padding-block-end: var(--space-2);
    border-block-end: var(--border-hairline) solid currentColor;
    color: var(--color-accent-bar);
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-extrabold);
    font-size: calc(var(--type-h5-size) + 0.0625rem);
    line-height: 1.1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .split-text__text a:hover {
    opacity: var(--opacity-brand-hover);
  }

  @media screen and (min-width: 990px) {
    .split-text {
      padding-block: var(--section-pt) var(--section-pb);
    }

    .split-text__inner {
      grid-template-columns: minmax(min-content, 1fr) minmax(0, calc(var(--space-112) * 5 + var(--space-40)));
      align-items: start;
      gap: var(--space-80);
      max-width: calc(var(--space-112) * 11 + var(--space-80));
      padding-inline-end: calc(var(--space-40) - var(--space-2));
      text-align: start;
    }

    .split-text__titles {
      margin-block-start: calc((var(--space-24) + var(--space-14)) * -1);
      gap: var(--space-24);
    }

    .split-text .split-text__eyebrow {
      font-size: var(--type-eyebrow-small-size);
    }

    .split-text .split-text__heading.type-display {
      font-size: calc(var(--type-display-size) + var(--space-10));
    }

    .split-text__text {
      font-size: calc(var(--type-body-large-size) + var(--space-2));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.split_text",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.split_text_heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "options": [
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:settings.heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "display",
          "label": "t:options.display"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:info.split_text_text"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:settings.anchor_id",
      "info": "t:info.section_anchor"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "same_padding_mobile",
      "label": "t:settings.same_at_mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.split_text",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}
