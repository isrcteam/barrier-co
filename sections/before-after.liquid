{%- liquid
  assign card_scope = section.id | append: '-card'

  assign comparisons = section.settings.comparisons
  if section.settings.use_product_data and product != blank and product.metafields.custom.before_afters != blank
    assign comparisons = product.metafields.custom.before_afters.value
  endif

  assign comparison_count = 0
  for counted_item in comparisons
    assign comparison_count = comparison_count | plus: 1
  endfor
  if comparison_count == 0 and request.design_mode
    assign comparison_count = 1
  endif

  assign spotlight_product = section.settings.product
  if spotlight_product == blank and product != blank
    assign spotlight_product = product
  endif

  assign before_default = 'content.before_label' | t
  assign after_default = 'content.after_label' | t
  assign image_sizes = '(min-width: 990px) 32vw, 50vw'

  assign padding_top = section.settings['padding-block-start']
  assign padding_bottom = section.settings['padding-block-end']
  assign padding_top_mobile = section.settings['padding-block-start-mobile']
  assign padding_bottom_mobile = section.settings['padding-block-end-mobile']
  if section.settings.same_padding_mobile
    assign padding_top_mobile = padding_top
    assign padding_bottom_mobile = padding_bottom
  endif
-%}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% render 'contrast-override', background_color: section.settings.card_background_color, section_id: card_scope %}

<div
  class="before-after before-after--card-{{ section.settings.card_size | default: 'compact' }} color-custom-{{ section.id }}"
  style="
    --section-padding-top: {{ padding_top | divided_by: 16.0 }}rem;
    --section-padding-bottom: {{ padding_bottom | divided_by: 16.0 }}rem;
    --section-padding-top-mobile: {{ padding_top_mobile | divided_by: 16.0 }}rem;
    --section-padding-bottom-mobile: {{ padding_bottom_mobile | divided_by: 16.0 }}rem;
  "
>
  <div class="before-after__inner">
    <div class="before-after__intro">
      <div class="before-after__text-stack">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="before-after__heading type-h1">
            {{- section.settings.heading | escape -}}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="before-after__text type-body">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if spotlight_product != blank -%}
        <div class="before-after__product color-custom-{{ card_scope }}">
          {% render 'product-spotlight',
            product: spotlight_product,
            style: 'row',
            button_label: section.settings.product_button_label,
            price_label: section.settings.product_price_label,
            image_sizes: '8rem'
          %}
        </div>
      {%- endif -%}
    </div>

    {%- if comparison_count > 0 -%}
      <div class="before-after__slider">
        {%- capture slides -%}
          {%- liquid
            assign loop_source = comparisons
            if comparisons == blank
              assign loop_source = '1' | split: ','
            endif
          -%}
          {%- for entry in loop_source -%}
            {%- liquid
              assign index0 = forloop.index0
              assign before_image = entry.before_image.value
              assign after_image = entry.after_image.value
              assign before_label = entry.before_label.value | default: before_default
              assign after_label = entry.after_label.value | default: after_default
              assign testimonial = entry.testimonial.value
            -%}
            {%- capture slide -%}
              <div class="before-after__slide">
                <div class="before-after__pair">
                  <div class="before-after__photo">
                    {%- if before_image != blank -%}
                      {{
                        before_image
                        | image_url: width: 1200
                        | image_tag:
                          widths: '200, 400, 600, 900, 1200',
                          sizes: image_sizes,
                          loading: 'lazy',
                          class: 'before-after__image',
                          alt: before_image.alt
                      }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'before-after__image before-after__placeholder' }}
                    {%- endif -%}
                    <span class="before-after__label type-h5">{{ before_label | escape }}</span>
                  </div>
                  <div class="before-after__photo">
                    {%- if after_image != blank -%}
                      {{
                        after_image
                        | image_url: width: 1200
                        | image_tag:
                          widths: '200, 400, 600, 900, 1200',
                          sizes: image_sizes,
                          loading: 'lazy',
                          class: 'before-after__image',
                          alt: after_image.alt
                      }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'before-after__image before-after__placeholder' }}
                    {%- endif -%}
                    <span class="before-after__label type-h5">{{ after_label | escape }}</span>
                  </div>
                </div>

                {%- if testimonial != blank -%}
                  {%- assign rating = testimonial.rating.value.rating | default: 0 | times: 1.0 -%}
                  {%- assign avatar = testimonial.avatar.value -%}
                  <figure class="before-after__quote color-custom-{{ card_scope }}">
                    <blockquote class="before-after__quote-text type-body">
                      <p>{{ testimonial.quote.value | escape | newline_to_br }}</p>
                    </blockquote>
                    <figcaption class="before-after__author">
                      {%- if avatar != blank -%}
                        {{
                          avatar
                          | image_url: width: 120
                          | image_tag:
                            widths: '40, 80, 120',
                            sizes: '3rem',
                            loading: 'lazy',
                            class: 'before-after__avatar',
                            alt: ''
                        }}
                      {%- endif -%}
                      <span class="before-after__author-text">
                        {%- if rating > 0 -%}
                          {% render 'star-rating', rating: rating, size: 'medium' %}
                        {%- endif -%}
                        <span class="before-after__name type-h5">{{ testimonial.name.value | escape }}</span>
                      </span>
                    </figcaption>
                  </figure>
                {%- endif -%}
              </div>
            {%- endcapture -%}
            {% render 'slideshow-slide', index: index0, children: slide, class: 'before-after__slideshow-slide' %}
          {%- endfor -%}
        {%- endcapture -%}

        {%- capture controls -%}
          {%- if comparison_count > 1 -%}
            {% render 'slideshow-controls',
              style: 'dots',
              item_count: comparison_count,
              show_arrows: true,
              arrows_on_media: false,
              controls_on_media: false,
              pagination_position: 'center',
              icon_style: 'arrow',
              class: 'before-after__controls'
            %}
          {%- endif -%}
        {%- endcapture -%}

        {% render 'slideshow',
          ref: 'beforeAfterSlideshow',
          class: 'before-after__slideshow',
          slides: slides,
          controls: controls,
          slide_count: comparison_count,
          infinite: false,
          initial_slide: 0,
          show_arrows: false
        %}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .before-after {
    padding-block: var(--section-padding-top-mobile) var(--section-padding-bottom-mobile);
    padding-inline: var(--layout-gutter);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .before-after__inner {
    display: grid;
    gap: var(--space-24);
    max-width: var(--layout-content-width);
    margin-inline: auto;
  }

  .before-after__intro {
    display: grid;
    gap: var(--space-20);
    align-content: start;
  }

  .before-after__text-stack {
    display: grid;
    gap: var(--space-24);
  }

  .before-after__heading {
    margin: 0;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .before-after__text {
    font-size: var(--type-body-large-size);
    color: color-mix(in srgb, var(--color-foreground) calc(var(--opacity-brand-muted) * 100%), transparent);
  }

  .before-after__text > * {
    margin: 0;
  }

  .before-after__product .product-spotlight {
    padding: var(--space-12);
    gap: var(--space-20);
    backdrop-filter: blur(var(--layout-blur-card));
  }

  .before-after__product .product-spotlight__media {
    width: calc(var(--space-112) + var(--space-12));
    padding: var(--space-6) var(--space-2);
  }

  .before-after__product .product-spotlight__image {
    mix-blend-mode: multiply;
  }

  .before-after__slider {
    min-width: 0;
  }

  .before-after__slideshow slideshow-slide.before-after__slideshow-slide {
    content-visibility: visible;
  }

  .before-after__slide {
    display: grid;
    gap: var(--space-12);
  }

  .before-after__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
  }

  .before-after__photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 179 / 240;
  }

  .before-after__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .before-after__placeholder {
    background: color-mix(in srgb, var(--color-foreground) calc(var(--opacity-brand-subtle) * 100%), transparent);
  }

  .before-after__label {
    position: absolute;
    inset-block-start: var(--space-4);
    inset-inline-start: var(--space-4);
    padding: var(--space-8) var(--space-16);
    background: var(--color-white);
    backdrop-filter: blur(var(--layout-blur-label));
    color: var(--color-foreground);
    text-transform: uppercase;
  }

  .before-after__quote {
    display: grid;
    gap: var(--space-20);
    margin: 0;
    padding: var(--space-12);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .before-after__quote-text {
    margin: 0;
    font-size: var(--type-body-large-size);
  }

  .before-after__quote-text p {
    margin: 0;
  }

  .before-after__author {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .before-after__avatar {
    border-radius: var(--radius-full);
    flex: none;
    width: var(--space-40);
    height: var(--space-40);
    object-fit: cover;
  }

  .before-after__author-text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .before-after__name {
    text-transform: uppercase;
  }

  /* 12 from the quote card to the 6px dot; the 24 tap row adds 9 above it */
  .before-after__controls {
    margin-block-start: calc(var(--space-6) + 0.0625rem);
    min-height: auto;
    mix-blend-mode: normal;
  }

  .before-after slideshow-controls.before-after__controls {
    justify-content: center;
  }

  .before-after__controls .slideshow-controls__arrows {
    display: none;
  }

  .before-after__controls .slideshow-controls__dots {
    margin-inline: auto;
    gap: 0;
    padding: 0;
    border-radius: var(--radius-none);
  }

  .before-after__controls .slideshow-controls__dots button {
    --size: var(--space-6);
    --color: color-mix(in srgb, var(--color-accent-bar) calc(var(--opacity-brand-inactive) * 100%), transparent);
    --color-hover: var(--color-accent-bar);
    --color-active: var(--color-accent-bar);
    border-radius: var(--radius-none);
  }

  .before-after__controls .slideshow-controls__dots button::after {
    border-radius: var(--radius-none);
    box-shadow: none;
  }

  /* Figma's arrow row is the 14px glyph plus 12 above and below (38), not Horizon's 44px button */
  .before-after__controls .slideshow-control {
    height: var(--space-14);
    min-block-size: 0;
    padding: 0;
  }

  .before-after__controls .slideshow-control:focus-visible {
    outline: var(--border-hairline) solid var(--color-foreground);
    box-shadow: var(--effect-focus-ring);
  }

  @media screen and (min-width: 990px) {
    .before-after {
      padding-block: var(--section-padding-top) var(--section-padding-bottom);
    }

    .before-after__inner {
      grid-template-columns: minmax(0, calc(var(--space-112) * 4 - var(--space-20))) minmax(0, 1fr);
      gap: var(--space-80);
      align-items: start;
    }

    .before-after__text {
      font-size: var(--type-body-size);
    }

    .before-after__product {
      justify-self: start;
    }

    .before-after__product .product-spotlight {
      padding-inline-end: calc(var(--space-40) + var(--space-10));
    }

    /* Large card (PDP Figma 965:2355): 287 text column, ExtraBold 24 title, full-width 43 button.
       Home Figma draws the compact card (Medium 14 title), so the size is a setting. */
    /* Figma 965:2350: the intro column is as wide as the large card (493) */
    .before-after--card-large .before-after__inner {
      grid-template-columns: minmax(0, calc(var(--space-112) * 4 + var(--space-40) + var(--space-4) + 0.0625rem)) minmax(0, 1fr);
    }

    .before-after--card-large .before-after__product .product-spotlight {
      grid-template-columns: var(--spotlight-media) minmax(0, calc(var(--space-112) * 2 + var(--space-60) + var(--space-4)));
    }

    .before-after--card-large .before-after__product .product-spotlight__title {
      font-weight: var(--font-weight-extrabold);
      font-size: var(--space-24);
      line-height: normal;
    }

    .before-after--card-large .before-after__product .product-spotlight__button.button--small {
      min-block-size: calc(var(--layout-button-small) + var(--space-2) + 0.0625rem);
      font-size: var(--type-button-size);
    }

    .before-after__photo {
      aspect-ratio: 43 / 45;
    }

    .before-after__quote-text {
      font-size: var(--type-body-size);
    }

    /* Figma arrow row: 24 below the quote card, then the 14 glyph */
    .before-after__controls {
      min-block-size: 0;
      margin-block-start: 0;
      padding-block: var(--space-24) 0;
    }

    /* Large card layout (PDP): photos keep Figma's 397.5 x 450 in the narrower slider column */
    .before-after--card-large .before-after__photo {
      aspect-ratio: 53 / 60;
    }

    .before-after slideshow-controls.before-after__controls {
      justify-content: space-between;
    }

    .before-after__controls .slideshow-controls__arrows {
      display: flex;
      height: auto;
    }

    .before-after__controls .slideshow-controls__dots {
      display: none;
    }

    .before-after__controls .slideshow-control {
      padding-inline: 0;
      color: var(--color-foreground);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .before-after__slideshow slideshow-slides {
      scroll-behavior: auto;
    }
  }

  .before-after .before-after__heading {
    text-wrap: wrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.before_after",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Before / after"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "<p>Real results from real people. The Barrier Cloth delivers active hydration deeply where it counts, reducing redness and smoothing skin texture in 14 days.</p>"
    },
    {
      "type": "header",
      "content": "t:content.product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product",
      "info": "t:info.product_card_fallback"
    },
    {
      "type": "text",
      "id": "product_price_label",
      "label": "t:settings.price_label",
      "info": "t:info.price_placeholder",
      "default": "Starts from [price]"
    },
    {
      "type": "text",
      "id": "product_button_label",
      "label": "t:settings.button_label",
      "default": "Shop now"
    },
    {
      "type": "header",
      "content": "t:content.comparisons"
    },
    {
      "type": "checkbox",
      "id": "use_product_data",
      "label": "t:settings.use_product_data",
      "info": "t:info.use_product_before_afters",
      "default": false
    },
    {
      "type": "metaobject_list",
      "id": "comparisons",
      "label": "t:settings.comparisons",
      "metaobject_type": "before_after"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "t:settings.card_background_color",
      "alpha": false
    },
    {
      "type": "select",
      "id": "card_size",
      "label": "t:settings.card_size",
      "info": "t:info.before_after_card_size",
      "options": [
        {
          "value": "compact",
          "label": "t:options.compact"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "compact"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "same_padding_mobile",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.before_after",
      "category": "t:categories.storytelling",
      "settings": {
        "heading": "Before / after",
        "heading_tag": "h2",
        "text": "<p>Real results from real people. The Barrier Cloth delivers active hydration deeply where it counts, reducing redness and smoothing skin texture in 14 days.</p>",
        "product_price_label": "Starts from [price]",
        "product_button_label": "Shop now"
      }
    }
  ]
}
{% endschema %}
