{%- liquid
  assign autoplay_on = false
  if section.settings.video_playback == 'autoplay'
    assign autoplay_on = true
  endif
  assign s = section.settings
  assign heading_tag = s.heading_tag | default: 'h2'

  assign padding_top_mobile = s['padding-block-start']
  assign padding_bottom_mobile = s['padding-block-end']
  if s.same_padding_mobile == false
    assign padding_top_mobile = s['padding-block-start-mobile']
    assign padding_bottom_mobile = s['padding-block-end-mobile']
  endif

  if s.show_second_tile
    assign tiles = 'first,second' | split: ','
    assign layout_class = 'intro-media--split'
  else
    assign tiles = 'first' | split: ','
    assign layout_class = 'intro-media--single'
  endif
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div
  class="intro-media {{ layout_class }} color-custom-{{ section.id }}"
  style="--intro-media-pt: {{ s['padding-block-start'] | divided_by: 16.0 }}rem; --intro-media-pb: {{ s['padding-block-end'] | divided_by: 16.0 }}rem; --intro-media-pt-mobile: {{ padding_top_mobile | divided_by: 16.0 }}rem; --intro-media-pb-mobile: {{ padding_bottom_mobile | divided_by: 16.0 }}rem;"
>
  <div class="intro-media__container">
    {%- if s.eyebrow != blank or s.heading != blank or s.text != blank -%}
      <div class="intro-media__header">
        {%- if s.eyebrow != blank or s.heading != blank -%}
          <div class="intro-media__titles">
            {%- if s.eyebrow != blank -%}
              <p class="intro-media__eyebrow type-eyebrow">{{ s.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if s.heading != blank -%}
              <{{ heading_tag }} class="intro-media__heading type-h1">{{ s.heading | escape }}</{{ heading_tag }}>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="intro-media__text type-body-large">{{ s.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="intro-media__tiles">
      {%- for tile in tiles -%}
        {%- liquid
          assign prefix = ''
          if tile == 'second'
            assign prefix = 'second_'
          endif
          assign media_type_key = prefix | append: 'media_type'
          assign image_key = prefix | append: 'image'
          assign video_key = prefix | append: 'video'
          assign video_url_key = prefix | append: 'video_url'
          assign poster_key = prefix | append: 'poster'

          assign tile_type = s[media_type_key]
          assign tile_image = s[image_key]
          assign tile_video = s[video_key]
          assign tile_video_url = s[video_url_key]
          assign tile_poster = s[poster_key] | default: tile_video.preview_image | default: tile_image

          if s.show_second_tile
            if forloop.first
              assign tile_sizes = '(min-width: 990px) 60vw, 100vw'
            else
              assign tile_sizes = '(min-width: 990px) 40vw, 100vw'
            endif
          else
            assign tile_sizes = '100vw'
          endif

          assign can_play = false
          if tile_type == 'video'
            if tile_video != blank
              assign can_play = true
            elsif tile_video_url != blank and tile_poster != blank
              assign can_play = true
            endif
          endif
        -%}
        <div class="intro-media__tile">
          {%- if can_play -%}
            {% render 'video-player',
              video: tile_video,
              video_url: tile_video_url,
              poster: tile_poster,
              play_size: 'large',
              autoplay: autoplay_on
            %}
          {%- elsif tile_image != blank -%}
            {{
              tile_image
              | image_url: width: 3840
              | image_tag:
                widths: '390, 750, 1100, 1500, 1920, 2560, 2880, 3840',
                sizes: tile_sizes,
                loading: 'lazy',
                class: 'intro-media__image',
                alt: tile_image.alt
            }}
          {%- else -%}
            {{ 'hero-apparel-2' | placeholder_svg_tag: 'intro-media__image intro-media__placeholder' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .intro-media {
    padding-block: var(--intro-media-pt-mobile) var(--intro-media-pb-mobile);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .intro-media__container {
    display: grid;
    gap: var(--space-24);
    max-width: var(--layout-page-width);
    margin-inline: auto;
  }

  .intro-media__header {
    display: grid;
    gap: var(--space-16);
    padding-inline: var(--layout-gutter);
  }

  .intro-media__titles {
    display: grid;
    gap: var(--space-16);
  }

  .intro-media__eyebrow,
  .intro-media__heading {
    margin: 0;
    text-transform: uppercase;
  }

  .intro-media__text > * {
    margin: 0;
  }

  .intro-media__text > * + * {
    margin-block-start: var(--space-16);
  }

  .intro-media__text strong,
  .intro-media__text b {
    font-weight: var(--font-weight-medium);
  }

  .intro-media__tiles {
    display: grid;
    gap: var(--layout-grid-gap);
  }

  .intro-media__tile {
    position: relative;
    overflow: hidden;
    aspect-ratio: 13 / 11;
  }

  .intro-media__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro-media__placeholder {
    background: var(--color-foreground);
    opacity: var(--opacity-brand-subtle);
  }

  @media screen and (min-width: 990px) {
    .intro-media {
      padding-block: var(--intro-media-pt) var(--intro-media-pb);
    }

    .intro-media__container {
      gap: var(--space-30);
      padding-inline: var(--layout-gutter);
    }

    .intro-media__header {
      grid-template-columns: minmax(0, 1fr) minmax(0, calc(var(--layout-text-width) + var(--space-80) - var(--space-4)));
      align-items: end;
      gap: var(--space-30);
      padding-inline: 0;
    }

    .intro-media__text {
      font-size: var(--type-body-size);
    }

    .intro-media--single .intro-media__tile {
      aspect-ratio: 23 / 11;
    }

    .intro-media--split .intro-media__header,
    .intro-media--split .intro-media__tiles {
      grid-template-columns: minmax(0, 1fr) calc(var(--layout-text-width) - var(--space-8));
      gap: var(--space-30);
    }

    .intro-media--split .intro-media__tile {
      aspect-ratio: auto;
    }

    .intro-media--split .intro-media__tile:first-child {
      aspect-ratio: 399 / 287;
    }
  }

  @media screen and (min-width: 990px) {
    .intro-media__text {
      justify-self: end;
      max-width: calc(var(--layout-text-width) + var(--space-80) - var(--space-4));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.intro_media",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "The Barrier Cloth"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Beauty that’s more than skin deep."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "header",
      "content": "t:content.media_1"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.media_type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "video"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:settings.video_external_url",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "info": "t:info.video_external",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "t:settings.video_cover_image",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.media_2"
    },
    {
      "type": "checkbox",
      "id": "show_second_tile",
      "label": "t:settings.show_second_tile",
      "default": false
    },
    {
      "type": "select",
      "id": "second_media_type",
      "label": "t:settings.media_type_2",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "video",
      "visible_if": "{{ section.settings.show_second_tile }}"
    },
    {
      "type": "image_picker",
      "id": "second_image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.show_second_tile and section.settings.second_media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "second_video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.show_second_tile and section.settings.second_media_type == 'video' }}"
    },
    {
      "type": "video_url",
      "id": "second_video_url",
      "label": "t:settings.video_external_url",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "info": "t:info.video_external",
      "visible_if": "{{ section.settings.show_second_tile and section.settings.second_media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_playback",
      "label": "t:settings.video_playback",
      "info": "t:info.video_playback",
      "options": [
        {
          "value": "click",
          "label": "t:options.play_on_click"
        },
        {
          "value": "autoplay",
          "label": "t:options.autoplay_muted"
        }
      ],
      "default": "autoplay"
    },
    {
      "type": "image_picker",
      "id": "second_poster",
      "label": "t:settings.video_cover_image",
      "visible_if": "{{ section.settings.show_second_tile and section.settings.second_media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "same_padding_mobile",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.intro_media",
      "category": "t:categories.storytelling",
      "settings": {
        "eyebrow": "The Barrier Cloth",
        "heading": "Beauty that’s more than skin deep.",
        "heading_tag": "h2",
        "text": "<p>Most skincare sits on the surface. The Barrier Cloth works beneath it delivering hyaluronic acid, glycerin, and barrier-strengthening actives directly into the skin. One cloth cleanses, hydrates, and protects in a single step. No bottles. No layering. No 10-step routine. Just full-body skincare.</p>",
        "media_type": "video",
        "show_second_tile": false
      }
    },
    {
      "name": "t:names.editorial",
      "category": "t:categories.storytelling",
      "settings": {
        "eyebrow": "The Barrier Cloth",
        "heading": "Beauty that’s more than skin deep.",
        "heading_tag": "h2",
        "text": "<p>Most skincare sits on the surface. The Barrier Cloth works beneath it delivering hyaluronic acid, glycerin, and barrier-strengthening actives directly into the skin. One cloth cleanses, hydrates, and protects in a single step. No bottles. No layering. No 10-step routine. Just full-body skincare.</p>",
        "media_type": "image",
        "show_second_tile": true,
        "second_media_type": "video"
      }
    }
  ]
}
{% endschema %}
