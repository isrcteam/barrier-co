{%- liquid
  assign s = section.settings

  assign padding_top_mobile = s.padding_top
  assign padding_bottom_mobile = s.padding_bottom
  if s.same_padding_mobile == false
    assign padding_top_mobile = s.padding_top_mobile
    assign padding_bottom_mobile = s.padding_bottom_mobile
  endif

  assign ratio_mobile = s.ratio_desktop
  if s.same_ratio_mobile == false
    assign ratio_mobile = s.ratio_mobile
  endif

  assign poster_desktop = s.poster_desktop | default: s.video.preview_image
  assign poster_mobile = poster_desktop
  assign has_mobile_poster = false
  if s.same_poster_mobile == false and s.poster_mobile != blank
    assign poster_mobile = s.poster_mobile
    assign has_mobile_poster = true
  endif

  assign can_play = false
  if s.video != blank
    assign can_play = true
  elsif s.video_url != blank and poster_desktop != blank
    assign can_play = true
  endif
-%}

{% render 'contrast-override', background_color: s.background_color, section_id: section.id %}

<div
  class="video-banner video-banner--{{ s.width }} color-custom-{{ section.id }}"
  style="--video-banner-ratio: {{ s.ratio_desktop }}; --video-banner-ratio-mobile: {{ ratio_mobile }}; --video-banner-pt: {{ s.padding_top | divided_by: 16.0 }}rem; --video-banner-pb: {{ s.padding_bottom | divided_by: 16.0 }}rem; --video-banner-pt-mobile: {{ padding_top_mobile | divided_by: 16.0 }}rem; --video-banner-pb-mobile: {{ padding_bottom_mobile | divided_by: 16.0 }}rem;"
>
  <div class="video-banner__frame">
    {%- if can_play -%}
      {%- if has_mobile_poster -%}
        {% render 'video-player',
          video: s.video,
          video_url: s.video_url,
          poster: poster_mobile,
          play_size: 'large',
          loop: s.loop,
          class: 'video-banner__player video-banner__player--mobile'
        %}
        {% render 'video-player',
          video: s.video,
          video_url: s.video_url,
          poster: poster_desktop,
          play_size: 'large',
          loop: s.loop,
          class: 'video-banner__player video-banner__player--desktop'
        %}
      {%- else -%}
        {% render 'video-player',
          video: s.video,
          video_url: s.video_url,
          poster: poster_desktop,
          play_size: 'large',
          loop: s.loop,
          class: 'video-banner__player'
        %}
      {%- endif -%}
    {%- elsif poster_desktop != blank -%}
      {{
        poster_desktop
        | image_url: width: 3840
        | image_tag:
          widths: '390, 750, 1100, 1500, 1920, 2560, 2880, 3840',
          sizes: '100vw',
          loading: 'lazy',
          class: 'video-banner__image',
          alt: poster_desktop.alt
      }}
    {%- else -%}
      {{ 'hero-apparel-3' | placeholder_svg_tag: 'video-banner__image video-banner__placeholder' }}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .video-banner {
    padding-block: var(--video-banner-pt-mobile) var(--video-banner-pb-mobile);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .video-banner__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 100 / var(--video-banner-ratio-mobile);
  }

  .video-banner__frame .video-banner__player,
  .video-banner__image {
    position: absolute;
    inset: 0;
  }

  .video-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-banner__placeholder {
    background: var(--color-foreground);
    opacity: var(--opacity-brand-subtle);
  }

  .video-banner__frame .video-banner__player--desktop {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .video-banner {
      padding-block: var(--video-banner-pt) var(--video-banner-pb);
    }

    .video-banner__frame {
      aspect-ratio: 100 / var(--video-banner-ratio);
    }

    .video-banner--inset .video-banner__frame {
      max-width: var(--layout-content-width);
      margin-inline: max(var(--layout-gutter), calc((100% - var(--layout-content-width)) / 2));
    }

    .video-banner__frame .video-banner__player--mobile {
      display: none;
    }

    .video-banner__frame .video-banner__player--desktop {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.video_banner",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:settings.video_external_url",
      "accept": ["youtube", "vimeo"],
      "info": "t:info.video_external"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "t:settings.video_loop",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "poster_desktop",
      "label": "t:settings.desktop_poster"
    },
    {
      "type": "checkbox",
      "id": "same_poster_mobile",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "poster_mobile",
      "label": "t:settings.mobile_poster",
      "visible_if": "{{ section.settings.same_poster_mobile == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        { "value": "full", "label": "t:options.full" },
        { "value": "inset", "label": "t:options.inset" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "ratio_desktop",
      "label": "t:settings.height_ratio",
      "info": "t:info.height_ratio",
      "min": 30,
      "max": 150,
      "step": 2,
      "unit": "%",
      "default": 54
    },
    {
      "type": "checkbox",
      "id": "same_ratio_mobile",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "ratio_mobile",
      "label": "t:settings.height_ratio_mobile",
      "min": 30,
      "max": 150,
      "step": 2,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.same_ratio_mobile == false }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "same_padding_mobile",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.video_banner",
      "category": "t:categories.storytelling",
      "settings": {
        "width": "full",
        "ratio_desktop": 54,
        "same_ratio_mobile": false,
        "ratio_mobile": 100,
        "padding_top": 80,
        "padding_bottom": 0,
        "same_padding_mobile": false,
        "padding_top_mobile": 0,
        "padding_bottom_mobile": 0
      }
    }
  ]
}
{% endschema %}
