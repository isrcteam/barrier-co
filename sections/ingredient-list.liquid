{%- liquid
  assign settings_ref = section.settings

  assign pad_top = settings_ref['padding-block-start'] | divided_by: 16.0
  assign pad_bottom = settings_ref['padding-block-end'] | divided_by: 16.0
  if settings_ref.same_padding_mobile
    assign pad_top_mobile = pad_top
    assign pad_bottom_mobile = pad_bottom
  else
    assign pad_top_mobile = settings_ref['padding-block-start-mobile'] | divided_by: 16.0
    assign pad_bottom_mobile = settings_ref['padding-block-end-mobile'] | divided_by: 16.0
  endif

  assign items = empty
  if settings_ref.use_product_data and product != blank
    assign items = product.metafields.custom.ingredients.value
  endif
  assign items_count = 0
  for counted_item in items
    assign items_count = items_count | plus: 1
  endfor
  if items_count == 0
    assign items = settings_ref.ingredients
    assign items_count = 0
    for counted_item in items
      assign items_count = items_count | plus: 1
    endfor
  endif

  assign show_placeholders = false
  if items_count == 0
    if request.design_mode
      assign show_placeholders = true
    endif
  endif

  assign heading_tag = settings_ref.heading_tag | default: 'h2'
  assign name_tag = settings_ref.name_tag | default: 'h3'
  assign image_sizes = '(min-width: 990px) 22vw, 112px'
-%}

{%- if items_count > 0 or show_placeholders -%}
  {% render 'contrast-override',
    background_color: section.settings.background_color,
    section_id: section.id
  %}

  <div
    class="ingredient-list color-custom-{{ section.id }}"
    style="--section-padding-top: {{ pad_top }}rem; --section-padding-bottom: {{ pad_bottom }}rem; --section-padding-top-mobile: {{ pad_top_mobile }}rem; --section-padding-bottom-mobile: {{ pad_bottom_mobile }}rem;{% if settings_ref.divider_color != blank %} --color-divider: {{ settings_ref.divider_color }};{% endif %}"
  >
    <div class="ingredient-list__inner">
      {%- if settings_ref.heading != blank -%}
        <{{ heading_tag }} class="ingredient-list__heading type-h1">{{ settings_ref.heading | escape }}</{{ heading_tag }}>
      {%- endif -%}

      <ul class="ingredient-list__rows" role="list">
        {%- if show_placeholders -%}
          {%- assign placeholder_names = 'placeholders.ingredient_names' | t | split: '|' -%}
          {%- assign placeholder_benefits = 'placeholders.ingredient_benefits' | t | split: '|' -%}
          {%- for name in placeholder_names -%}
            <li class="ingredient-list__row">
              <div class="ingredient-list__media">
                {{ 'image' | placeholder_svg_tag: 'ingredient-list__image ingredient-list__placeholder' }}
              </div>
              <div class="ingredient-list__body">
                <{{ name_tag }} class="ingredient-list__name type-title-bold">{{ name }}</{{ name_tag }}>
                <ul class="ingredient-list__benefits" role="list">
                  {%- for benefit in placeholder_benefits -%}
                    <li class="ingredient-list__benefit type-caption">
                      <span class="svg-wrapper ingredient-list__tick">{{ 'icon-tick.svg' | inline_asset_content }}</span>
                      <span>{{ benefit }}</span>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for item in items -%}
            {%- liquid
              assign item_name = item.name.value
              assign item_image = item.image.value
              assign item_benefits = item.benefits.value
            -%}
            <li class="ingredient-list__row">
              <div class="ingredient-list__media">
                {%- if item_image != blank -%}
                  {{
                    item_image
                    | image_url: width: 1100
                    | image_tag:
                      widths: '112, 224, 336, 560, 840, 1100',
                      sizes: image_sizes,
                      loading: 'lazy',
                      class: 'ingredient-list__image',
                      alt: item_image.alt
                  }}
                {%- endif -%}
              </div>
              <div class="ingredient-list__body">
                {%- if item_name != blank -%}
                  <{{ name_tag }} class="ingredient-list__name type-title-bold">{{ item_name | escape }}</{{ name_tag }}>
                {%- endif -%}
                {%- if item_benefits != blank -%}
                  <ul class="ingredient-list__benefits" role="list">
                    {%- for benefit in item_benefits -%}
                      <li class="ingredient-list__benefit type-caption">
                        <span class="svg-wrapper ingredient-list__tick">{{ 'icon-tick.svg' | inline_asset_content }}</span>
                        <span>{{ benefit | escape }}</span>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .ingredient-list {
    --ingredient-list-rule: var(--color-divider);

    padding-block: var(--section-padding-top-mobile) var(--section-padding-bottom-mobile);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .ingredient-list__inner {
    display: grid;
    gap: var(--space-30);
    max-width: calc(var(--layout-content-width) + var(--layout-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--layout-gutter);
  }

  .ingredient-list__heading {
    margin: 0;
    text-transform: uppercase;
  }

  .ingredient-list__rows,
  .ingredient-list__benefits {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ingredient-list__rows {
    display: grid;
    gap: var(--space-24);
  }

  .ingredient-list__row {
    display: grid;
    gap: var(--space-16);
    align-items: start;
    padding-block-end: var(--space-24);
    border-block-end: var(--border-hairline) solid var(--ingredient-list-rule);
  }

  .ingredient-list__row:last-child {
    border-block-end: 0;
  }

  .ingredient-list__media {
    inline-size: var(--space-112);
  }

  /* The ingredient PNGs have uneven canvases; Figma frames each one in the same 112 x 94 box, so rows stay one height */
  .ingredient-list__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 112 / 94;
    object-fit: contain;
    object-position: left top;
  }

  .ingredient-list__placeholder {
    aspect-ratio: 4 / 3;
    background: var(--color-foreground);
    opacity: var(--opacity-brand-subtle);
  }

  .ingredient-list__body {
    display: grid;
    gap: var(--space-10);
    align-content: start;
  }

  .ingredient-list__name {
    margin: 0;
    text-transform: uppercase;
  }

  .ingredient-list__benefits {
    display: grid;
    gap: var(--space-6);
  }

  .ingredient-list__benefit {
    display: flex;
    align-items: center;
    gap: var(--space-10);
  }

  .ingredient-list__tick.svg-wrapper {
    display: inline-flex;
    flex: none;
    inline-size: var(--icon-tick);
    block-size: auto;
    height: auto;
    color: var(--color-accent-bar);
  }

  .ingredient-list__tick svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (min-width: 990px) {
    .ingredient-list {
      padding-block: var(--section-padding-top) var(--section-padding-bottom);
    }

    .ingredient-list__inner {
      /* Figma's 431 column at the 60 heading; it grows with the fluid heading size so "INGREDIENTS" never splits */
      grid-template-columns: max(calc(var(--space-112) * 4 - var(--space-16)), calc(var(--type-h1-size) * 7.2)) minmax(0, 1fr);
      column-gap: calc(var(--space-80) * 2);
      align-items: start;
    }

    .ingredient-list__rows {
      gap: var(--space-40);
    }

    .ingredient-list__row {
      /* Figma 273 image : 492 text, kept as a ratio so the images grow with the section on wide screens */
      grid-template-columns: minmax(0, 273fr) minmax(0, 492fr);
      gap: var(--space-24);
      align-items: start;
    }

    .ingredient-list__media {
      inline-size: 100%;
    }

    .ingredient-list__image {
      object-position: center top;
    }

    .ingredient-list__name {
      font-size: calc(var(--space-30) + var(--space-2));
      line-height: 1.1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.ingredient_list",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.ingredient_list_heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "options": [
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "name_tag",
      "label": "t:settings.name_tag",
      "options": [
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "t:content.source"
    },
    {
      "type": "checkbox",
      "id": "use_product_data",
      "label": "t:settings.use_product_data",
      "info": "t:info.use_product_data_ingredients",
      "default": true
    },
    {
      "type": "metaobject_list",
      "id": "ingredients",
      "label": "t:settings.ingredients",
      "metaobject_type": "ingredient",
      "limit": 12
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "alpha": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "same_padding_mobile",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.ingredient_list",
      "category": "t:categories.product",
      "settings": {
        "heading": "t:text_defaults.ingredient_list_heading",
        "use_product_data": true
      }
    }
  ]
}
{% endschema %}
