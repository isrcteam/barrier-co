{%- liquid
  assign settings_ref = section.settings

  assign pad_top = settings_ref['padding-block-start'] | divided_by: 16.0
  assign pad_bottom = settings_ref['padding-block-end'] | divided_by: 16.0
  if settings_ref.same_padding_mobile
    assign pad_top_mobile = pad_top
    assign pad_bottom_mobile = pad_bottom
  else
    assign pad_top_mobile = settings_ref['padding-block-start-mobile'] | divided_by: 16.0
    assign pad_bottom_mobile = settings_ref['padding-block-end-mobile'] | divided_by: 16.0
  endif

  assign items = empty
  assign from_product = false
  if settings_ref.use_product_data and product != blank
    assign product_items = product.metafields.custom.faq_items.value
    assign product_items_count = 0
    for counted_item in product_items
      assign product_items_count = product_items_count | plus: 1
    endfor
    if product_items_count > 0
      assign items = product_items
      assign from_product = true
    endif
  endif
  if from_product == false
    assign items = settings_ref.faq_items
  endif

  assign items_count = 0
  for counted_item in items
    assign items_count = items_count | plus: 1
  endfor
  assign show_placeholders = false
  if items_count == 0
    if request.design_mode
      assign show_placeholders = true
    endif
  endif

  assign image = settings_ref.image
  # A different mobile image left empty means no photo on mobile (Figma mobile shows plain bands)
  assign image_mobile = image
  assign hide_image_mobile = false
  if settings_ref.image_mobile_same == false
    assign image_mobile = settings_ref.image_mobile
    if image_mobile == blank
      assign hide_image_mobile = true
    endif
  endif

  assign heading_tag = settings_ref.heading_tag | default: 'h2'
-%}

{%- if items_count > 0 or show_placeholders -%}
  {% render 'contrast-override',
    background_color: section.settings.background_color,
    section_id: section.id
  %}

  <div
    class="faq-panel color-custom-{{ section.id }}"
    style="--section-padding-top: {{ pad_top }}rem; --section-padding-bottom: {{ pad_bottom }}rem; --section-padding-top-mobile: {{ pad_top_mobile }}rem; --section-padding-bottom-mobile: {{ pad_bottom_mobile }}rem;{% if settings_ref.divider_color != blank %} --color-divider: {{ settings_ref.divider_color }};{% endif %}"
  >
    <div class="faq-panel__stage">
      {%- if image != blank or image_mobile != blank -%}
        <picture class="faq-panel__background{% if hide_image_mobile %} faq-panel__background--desktop{% endif %}">
          {%- if image_mobile != image and image != blank and hide_image_mobile == false -%}
            <source
              media="(min-width: 990px)"
              srcset="{{ image | image_url: width: 1100 }} 1100w, {{ image | image_url: width: 1500 }} 1500w, {{ image | image_url: width: 1920 }} 1920w, {{ image | image_url: width: 2880 }} 2880w, {{ image | image_url: width: 3840 }} 3840w"
              sizes="100vw"
            >
          {%- endif -%}
          {%- assign base_image = image_mobile | default: image -%}
          {{
            base_image
            | image_url: width: 3840
            | image_tag:
              widths: '390, 750, 1100, 1500, 1920, 2880, 3840',
              sizes: '100vw',
              loading: 'lazy',
              alt: '',
              class: 'faq-panel__background-image'
          }}
        </picture>
      {%- endif -%}

      <div class="faq-panel__frame">
        <div class="faq-panel__panel">
          {%- if settings_ref.heading != blank -%}
            <{{ heading_tag }} class="faq-panel__heading type-h1">{{ settings_ref.heading | escape }}</{{ heading_tag }}>
          {%- endif -%}

          <div class="faq-panel__body">
            <div class="faq-panel__list">
              {%- if show_placeholders -%}
                {%- assign placeholder_questions = 'placeholders.faq_questions' | t | split: '|' -%}
                {%- for question in placeholder_questions -%}
                  {%- liquid
                    assign is_open = false
                    if forloop.first and settings_ref.open_first
                      assign is_open = true
                    endif
                  -%}
                  {%- capture row -%}
                    <details class="details faq-panel__item" name="faq-{{ section.id }}"{% if is_open %} open{% endif %}>
                      <summary class="details__header faq-panel__question type-h5">
                        <span class="svg-wrapper icon-plus faq-panel__icon">
                          {{- 'icon-accordion.svg' | inline_asset_content -}}
                        </span>
                        <span>{{ question }}</span>
                      </summary>
                      <div class="details-content faq-panel__answer type-body">
                        <p>{{ 'placeholders.faq_answer' | t }}</p>
                      </div>
                    </details>
                  {%- endcapture -%}
                  {% render 'accordion-custom-component',
                    children: row,
                    open_by_default_on_desktop: is_open,
                    open_by_default_on_mobile: is_open
                  %}
                {%- endfor -%}
              {%- else -%}
                {%- for item in items -%}
                  {%- liquid
                    assign is_open = false
                    if forloop.first and settings_ref.open_first
                      assign is_open = true
                    endif
                  -%}
                  {%- capture row -%}
                    <details class="details faq-panel__item" name="faq-{{ section.id }}"{% if is_open %} open{% endif %}>
                      <summary class="details__header faq-panel__question type-h5">
                        <span class="svg-wrapper icon-plus faq-panel__icon">
                          {{- 'icon-accordion.svg' | inline_asset_content -}}
                        </span>
                        <span>{{ item.question.value | escape }}</span>
                      </summary>
                      <div class="details-content faq-panel__answer type-body">
                        {{ item.answer | metafield_tag }}
                      </div>
                    </details>
                  {%- endcapture -%}
                  {% render 'accordion-custom-component',
                    children: row,
                    open_by_default_on_desktop: is_open,
                    open_by_default_on_mobile: is_open
                  %}
                {%- endfor -%}
              {%- endif -%}
            </div>

            {%- if settings_ref.button_label != blank and settings_ref.button_link != blank -%}
              <a href="{{ settings_ref.button_link }}" class="button faq-panel__button">
                {{- settings_ref.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- if from_product -%}
    {%- capture faq_entities -%}
      {%- for item in items -%}
        {%- assign answer_text = item.answer | metafield_tag | strip_html | strip -%}
        {"@type":"Question","name":{{ item.question.value | json }},"acceptedAnswer":{"@type":"Answer","text":{{ answer_text | json }}}}
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    {%- endcapture -%}
    <script type="application/ld+json">
      {"@context":{{ 'https://schema.org' | json }},"@type":"FAQPage","mainEntity":[{{ faq_entities }}]}
    </script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .faq-panel {
    --faq-panel-rule: var(--color-divider);

    padding-block: var(--section-padding-top-mobile) var(--section-padding-bottom-mobile);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .faq-panel__stage {
    position: relative;
    padding-block: calc(var(--space-40) + var(--space-10));
  }

  .faq-panel__background,
  .faq-panel__background-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 989px) {
    .faq-panel__background--desktop {
      display: none;
    }
  }

  .faq-panel__frame {
    position: relative;
  }

  .faq-panel__panel {
    display: grid;
    gap: var(--space-24);
    padding: var(--space-40) var(--layout-gutter);
    background: var(--color-page-background, var(--color-background));
    color: var(--color-foreground);
  }

  .faq-panel__heading {
    margin: 0;
    text-transform: uppercase;
  }

  .faq-panel__body {
    display: grid;
    gap: var(--space-24);
  }

  .faq-panel__item {
    padding-block: var(--space-20);
    border-block-end: var(--border-hairline) solid var(--faq-panel-rule);
  }

  .faq-panel__question {
    display: flex;
    align-items: flex-start;
    gap: var(--space-10);
    text-transform: uppercase;
    list-style: none;
  }

  .faq-panel .faq-panel__question {
    min-block-size: 0;
    padding-block: 0;
  }

  .faq-panel__question::-webkit-details-marker {
    display: none;
  }

  .faq-panel__question:focus-visible {
    outline: var(--border-hairline) solid currentColor;
    outline-offset: var(--space-2);
    box-shadow: var(--effect-focus-ring);
  }

  .faq-panel summary .faq-panel__icon {
    flex: none;
    margin-inline-start: 0;
    inline-size: var(--space-14);
    block-size: var(--space-14);
  }

  .faq-panel__icon svg {
    width: 100%;
    height: 100%;
  }

  .faq-panel__answer {
    padding-inline-start: calc(var(--space-14) + var(--space-10));
    padding-block-start: var(--space-12);
    font-size: var(--space-16);
  }

  .faq-panel__answer > :first-child {
    margin-block-start: 0;
  }

  .faq-panel__answer > :last-child {
    margin-block-end: 0;
  }

  .faq-panel__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-block-size: var(--layout-button-medium);
    height: var(--layout-button-medium);
    padding-block: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-panel summary .svg-wrapper,
    .faq-panel summary .icon-plus :is(.horizontal, .vertical) {
      transition: none;
    }
  }

  @media screen and (min-width: 990px) {
    .faq-panel {
      padding-block: var(--section-padding-top) var(--section-padding-bottom);
    }

    .faq-panel__stage {
      padding: calc(var(--space-80) * 2) var(--layout-gutter);
    }

    .faq-panel__frame {
      display: flex;
      justify-content: center;
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;
      padding-inline: min(
        calc(var(--space-112) + var(--space-60) + var(--space-12)),
        calc((100% - var(--layout-text-width) - var(--space-86)) / 2 - var(--space-30))
      );
      border-inline: var(--space-30) solid var(--color-on-media);
    }

    .faq-panel__panel {
      inline-size: calc(var(--layout-text-width) + var(--space-86));
      max-inline-size: 100%;
      gap: var(--space-30);
      padding: var(--space-30);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.faq_panel",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.faq_panel_heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "options": [
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "t:content.source"
    },
    {
      "type": "checkbox",
      "id": "use_product_data",
      "label": "t:settings.use_product_data",
      "info": "t:info.use_product_data_faq",
      "default": true
    },
    {
      "type": "metaobject_list",
      "id": "faq_items",
      "label": "t:settings.faq_items",
      "metaobject_type": "faq_item",
      "limit": 20
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:settings.open_first",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.background_image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "checkbox",
      "id": "image_mobile_same",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:settings.mobile_image",
      "visible_if": "{{ section.settings.image_mobile_same == false }}",
      "info": "t:info.faq_mobile_image_empty"
    },
    {
      "type": "header",
      "content": "t:content.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.faq_panel_button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": false
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "alpha": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "same_padding_mobile",
      "label": "t:settings.same_at_mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.same_padding_mobile == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.faq_panel",
      "category": "t:categories.text",
      "settings": {
        "heading": "t:text_defaults.faq_panel_heading",
        "button_label": "t:text_defaults.faq_panel_button",
        "open_first": true
      }
    }
  ]
}
{% endschema %}
