{% doc %}
  Self-hosted brand fonts. Declares the faces, preloads the two weights used above the fold and points Horizon's font variables at the brand families.
{% enddoc %}
{{ 'akzidenz-grotesk-next-extrabold.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}
{{ 'gt-america-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}
{% style %}
  @font-face {
    font-family: 'Akzidenz-Grotesk Next';
    src: url('{{ 'akzidenz-grotesk-next-extrabold.woff2' | asset_url }}') format('woff2');
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Akzidenz-Grotesk Next';
    src: url('{{ 'akzidenz-grotesk-next-regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'GT America';
    src: url('{{ 'gt-america-regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'GT America';
    src: url('{{ 'gt-america-medium.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  :root {
    --font-body--family: var(--font-family-body);
    --font-body--style: normal;
    --font-body--weight: var(--font-weight-regular);
    --font-subheading--family: var(--font-family-body);
    --font-subheading--style: normal;
    --font-subheading--weight: var(--font-weight-medium);
    --font-heading--family: var(--font-family-heading);
    --font-heading--style: normal;
    --font-heading--weight: var(--font-weight-extrabold);
    --font-accent--family: var(--font-family-heading);
    --font-accent--style: normal;
    --font-accent--weight: var(--font-weight-medium);
  }
{% endstyle %}
