{% doc %}
  Self-hosted brand fonts. Declares the faces, preloads the two weights used above the fold and points Horizon's font variables at the brand families.
{% enddoc %}
{{ 'akzidenz-grotesk-next-extrabold.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}
{{ 'gt-america-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}
{% style %}
  @font-face {
    font-family: 'Akzidenz-Grotesk Next';
    src: url('{{ 'akzidenz-grotesk-next-extrabold.woff2' | asset_url }}') format('woff2');
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Akzidenz-Grotesk Next';
    src: url('{{ 'akzidenz-grotesk-next-regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'GT America';
    src: url('{{ 'gt-america-regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'GT America';
    src: url('{{ 'gt-america-medium.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  :root {
    --font-body--family: var(--font-family-body);
    --font-body--style: normal;
    --font-body--weight: var(--font-weight-regular);
    --font-subheading--family: var(--font-family-body);
    --font-subheading--style: normal;
    --font-subheading--weight: var(--font-weight-medium);
    --font-heading--family: var(--font-family-heading);
    --font-heading--style: normal;
    --font-heading--weight: var(--font-weight-extrabold);
    --font-accent--family: var(--font-family-heading);
    --font-accent--style: normal;
    --font-accent--weight: var(--font-weight-medium);
    --font-h1--family: var(--font-family-heading);
    --font-h1--weight: var(--font-weight-extrabold);
    --font-h1--size: var(--type-h1-size);
    --font-h1--line-height: var(--type-h1-line);
    --font-h1--letter-spacing: var(--type-h1-tracking);
    --font-h1--case: uppercase;
    --font-h2--family: var(--font-family-heading);
    --font-h2--weight: var(--font-weight-extrabold);
    --font-h2--size: var(--type-h2-size);
    --font-h2--line-height: var(--type-h2-line);
    --font-h2--letter-spacing: var(--type-h2-tracking);
    --font-h2--case: uppercase;
    --font-h3--family: var(--font-family-heading);
    --font-h3--weight: var(--font-weight-medium);
    --font-h3--size: var(--type-h3-size);
    --font-h3--line-height: var(--type-h3-line);
    --font-h3--letter-spacing: var(--type-h3-tracking);
    --font-h3--case: none;
    --font-h4--family: var(--font-family-heading);
    --font-h4--weight: var(--font-weight-medium);
    --font-h4--size: var(--type-h4-size);
    --font-h4--line-height: var(--type-h4-line);
    --font-h4--letter-spacing: var(--type-h4-tracking);
    --font-h4--case: none;
    --font-h5--family: var(--font-family-heading);
    --font-h5--weight: var(--font-weight-medium);
    --font-h5--size: var(--type-h5-size);
    --font-h5--line-height: var(--type-h5-line);
    --font-h5--letter-spacing: var(--type-h5-tracking);
    --font-h5--case: uppercase;
    --font-h6--family: var(--font-family-heading);
    --font-h6--weight: var(--font-weight-medium);
    --font-h6--size: var(--type-h6-size);
    --font-h6--line-height: var(--type-h6-line);
    --font-h6--letter-spacing: var(--type-h6-tracking);
    --font-h6--case: uppercase;
    --font-paragraph--size: var(--type-body-size);
    --font-paragraph--line-height: var(--type-body-line);
  }
{% endstyle %}
