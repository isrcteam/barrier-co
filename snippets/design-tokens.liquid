{% style %}
  :root {
    --space-2: 0.125rem;
    --space-4: 0.25rem;
    --space-6: 0.375rem;
    --space-8: 0.5rem;
    --space-10: 0.625rem;
    --space-12: 0.75rem;
    --space-14: 0.875rem;
    --space-16: 1rem;
    --space-20: 1.25rem;
    --space-24: 1.5rem;
    --space-30: 1.875rem;
    --space-40: 2.5rem;
    --space-60: 3.75rem;
    --space-80: 5rem;
    --space-86: 5.375rem;
    --space-112: 7rem;
    --layout-page-width: 120rem;
    --layout-content-width: 116.25rem;
    --layout-gutter-mobile: var(--space-10);
    --layout-gutter-desktop: var(--space-30);
    --layout-grid-gap-mobile: var(--space-10);
    --layout-grid-gap-desktop: var(--space-20);
    --layout-section-gap-mobile: var(--space-30);
    --layout-section-gap-desktop: var(--space-80);
    --layout-text-width: 35rem;
    --layout-buy-box-width: 30.125rem;
    --layout-blur-glass: var(--space-30);
    --layout-blur-card: 1.6875rem;
    --layout-blur-label: var(--space-6);
    --layout-button-large: 3.4375rem;
    --layout-button-medium: 2.75rem;
    --layout-button-small: 2.5rem;
    --layout-select-height: var(--layout-button-medium);
    --radius-none: 0;
    --radius-full: 62.4375rem;
    --border-hairline: 0.0625rem;
    --border-strong: 0.125rem;
    --icon-xs: 0.75rem;
    --icon-sm: 1rem;
    --icon-md: 1.5rem;
    --icon-play-small: 2.5rem;
    --icon-play-large: 3.5625rem;
    --icon-bar-mobile: var(--space-12);
    --icon-bar-desktop: var(--space-30);
    --opacity-brand-hover: 0.86;
    --opacity-brand-pressed: 0.72;
    --opacity-brand-disabled: 0.35;
    --opacity-brand-muted: 0.8;
    --opacity-brand-inactive: 0.34;
    --opacity-brand-glass: 0.28;
    --opacity-brand-glass-border: 0.6;
    --opacity-brand-overlay: 0.3;
    --opacity-brand-subtle: 0.2;
    --opacity-brand-focus: 0.35;
    --opacity-brand-shadow: 0.1;
    --effect-focus-ring: 0 0 var(--space-4) var(--space-2) color-mix(in srgb, var(--color-foreground) calc(var(--opacity-brand-focus) * 100%), transparent);
    --effect-sticky-shadow: 0 calc(-1 * var(--space-4)) var(--space-12) color-mix(in srgb, var(--color-overlay) calc(var(--opacity-brand-shadow) * 100%), transparent);
    --z-sticky-bar: 90;
    --z-header: 100;
    --z-drawer: 200;
    --z-modal: 300;
    --duration-fast: 150ms;
    --duration-base: 250ms;
    --duration-slow: 600ms;
    --duration-marquee: 40s;
    --easing-standard: cubic-bezier(0.2, 0, 0, 1);
    --easing-linear: linear;
    --font-family-heading: "Akzidenz-Grotesk Next", "Helvetica Neue", Arial, sans-serif;
    --font-family-body: "GT America", "Helvetica Neue", Arial, sans-serif;
    --font-weight-regular: 400;
    --font-weight-medium: 500;
    --font-weight-extrabold: 800;
    --color-rating: {{ settings.color_rating }};
    --color-rating-rgb: {{ settings.color_rating.red }} {{ settings.color_rating.green }} {{ settings.color_rating.blue }};
    --color-glass: {{ settings.color_glass }};
    --color-glass-rgb: {{ settings.color_glass.red }} {{ settings.color_glass.green }} {{ settings.color_glass.blue }};
    --color-overlay: {{ settings.color_overlay }};
    --color-overlay-rgb: {{ settings.color_overlay.red }} {{ settings.color_overlay.green }} {{ settings.color_overlay.blue }};
    --color-caption: {{ settings.color_caption }};
    --color-caption-rgb: {{ settings.color_caption.red }} {{ settings.color_caption.green }} {{ settings.color_caption.blue }};
    --color-accent-bar: {{ settings.color_accent_bar }};
    --color-accent-bar-rgb: {{ settings.color_accent_bar.red }} {{ settings.color_accent_bar.green }} {{ settings.color_accent_bar.blue }};
    --color-divider: {{ settings.color_divider }};
    --color-divider-rgb: {{ settings.color_divider.red }} {{ settings.color_divider.green }} {{ settings.color_divider.blue }};
    --color-on-media: {{ settings.color_on_media }};
    --color-on-media-rgb: {{ settings.color_on_media.red }} {{ settings.color_on_media.green }} {{ settings.color_on_media.blue }};
    --type-display-size: 2.5rem;
    --type-display-line: 0.9;
    --type-display-tracking: 0;
    --type-h1-size: 2rem;
    --type-h1-line: 1.1;
    --type-h1-tracking: 0;
    --type-h2-size: 1.5rem;
    --type-h2-line: 1;
    --type-h2-tracking: 0;
    --type-h3-size: 1.125rem;
    --type-h3-line: normal;
    --type-h3-tracking: 0;
    --type-h4-size: 1.125rem;
    --type-h4-line: normal;
    --type-h4-tracking: 0;
    --type-h5-size: 0.875rem;
    --type-h5-line: normal;
    --type-h5-tracking: 0;
    --type-h6-size: 0.75rem;
    --type-h6-line: normal;
    --type-h6-tracking: 0;
    --type-title-bold-size: 1.125rem;
    --type-title-bold-line: 1;
    --type-title-bold-tracking: 0;
    --type-card-label-size: 1.125rem;
    --type-card-label-line: 0.9;
    --type-card-label-tracking: 0;
    --type-stat-size: 4rem;
    --type-stat-line: 0.83;
    --type-stat-tracking: 0;
    --type-stat-unit-size: 2.75rem;
    --type-stat-unit-line: normal;
    --type-stat-unit-tracking: 0;
    --type-button-size: 0.875rem;
    --type-button-line: 1.1;
    --type-button-tracking: 0;
    --type-label-size: 0.75rem;
    --type-label-line: 1.1;
    --type-label-tracking: 0;
    --type-nav-size: 0.875rem;
    --type-nav-line: 1.1;
    --type-nav-tracking: 0;
    --type-announcement-size: 0.75rem;
    --type-announcement-line: 1.3;
    --type-announcement-tracking: 0;
    --type-eyebrow-size: 1rem;
    --type-eyebrow-line: normal;
    --type-eyebrow-tracking: 0.04em;
    --type-eyebrow-small-size: 1rem;
    --type-eyebrow-small-line: normal;
    --type-eyebrow-small-tracking: 0.04em;
    --type-body-large-size: 1rem;
    --type-body-large-line: 1.3;
    --type-body-large-tracking: 0;
    --type-body-size: 0.875rem;
    --type-body-line: 1.3;
    --type-body-tracking: 0;
    --type-body-small-size: 0.875rem;
    --type-body-small-line: 1.3;
    --type-body-small-tracking: 0;
    --type-caption-size: 0.75rem;
    --type-caption-line: normal;
    --type-caption-tracking: 0;
    --type-micro-size: 0.625rem;
    --type-micro-line: normal;
    --type-micro-tracking: 0;
    --layout-gutter: var(--layout-gutter-mobile);
    --layout-grid-gap: var(--layout-grid-gap-mobile);
    --layout-section-gap: var(--layout-section-gap-mobile);
  }

  @media screen and (min-width: 990px) {
    :root {
      --type-display-size: 3.75rem;
      --type-h1-size: 3.75rem;
      --type-h1-line: 0.9;
      --type-h2-size: 2.25rem;
      --type-h2-line: 0.9;
      --type-h3-size: 1.25rem;
      --type-card-label-size: 1.5rem;
      --type-stat-size: 6rem;
      --type-stat-line: 0.73;
      --type-eyebrow-size: 1.25rem;
      --type-body-large-size: 1.125rem;
      --type-body-size: 1rem;
      --layout-gutter: var(--layout-gutter-desktop);
      --layout-grid-gap: var(--layout-grid-gap-desktop);
      --layout-section-gap: var(--layout-section-gap-desktop);
    }
  }

  .type-display { font-family: var(--font-family-heading); font-weight: var(--font-weight-extrabold); font-size: var(--type-display-size); line-height: var(--type-display-line); letter-spacing: var(--type-display-tracking); }
  .type-h1 { font-family: var(--font-family-heading); font-weight: var(--font-weight-extrabold); font-size: var(--type-h1-size); line-height: var(--type-h1-line); letter-spacing: var(--type-h1-tracking); }
  .type-h2 { font-family: var(--font-family-heading); font-weight: var(--font-weight-extrabold); font-size: var(--type-h2-size); line-height: var(--type-h2-line); letter-spacing: var(--type-h2-tracking); }
  .type-h3 { font-family: var(--font-family-heading); font-weight: var(--font-weight-medium); font-size: var(--type-h3-size); line-height: var(--type-h3-line); letter-spacing: var(--type-h3-tracking); }
  .type-h4 { font-family: var(--font-family-heading); font-weight: var(--font-weight-medium); font-size: var(--type-h4-size); line-height: var(--type-h4-line); letter-spacing: var(--type-h4-tracking); }
  .type-h5 { font-family: var(--font-family-heading); font-weight: var(--font-weight-medium); font-size: var(--type-h5-size); line-height: var(--type-h5-line); letter-spacing: var(--type-h5-tracking); }
  .type-h6 { font-family: var(--font-family-heading); font-weight: var(--font-weight-medium); font-size: var(--type-h6-size); line-height: var(--type-h6-line); letter-spacing: var(--type-h6-tracking); }
  .type-title-bold { font-family: var(--font-family-heading); font-weight: var(--font-weight-extrabold); font-size: var(--type-title-bold-size); line-height: var(--type-title-bold-line); letter-spacing: var(--type-title-bold-tracking); }
  .type-card-label { font-family: var(--font-family-heading); font-weight: var(--font-weight-extrabold); font-size: var(--type-card-label-size); line-height: var(--type-card-label-line); letter-spacing: var(--type-card-label-tracking); }
  .type-stat { font-family: var(--font-family-heading); font-weight: var(--font-weight-medium); font-size: var(--type-stat-size); line-height: var(--type-stat-line); letter-spacing: var(--type-stat-tracking); }
  .type-stat-unit { font-family: var(--font-family-body); font-weight: var(--font-weight-medium); font-size: var(--type-stat-unit-size); line-height: var(--type-stat-unit-line); letter-spacing: var(--type-stat-unit-tracking); }
  .type-button { font-family: var(--font-family-heading); font-weight: var(--font-weight-extrabold); font-size: var(--type-button-size); line-height: var(--type-button-line); letter-spacing: var(--type-button-tracking); }
  .type-label { font-family: var(--font-family-body); font-weight: var(--font-weight-medium); font-size: var(--type-label-size); line-height: var(--type-label-line); letter-spacing: var(--type-label-tracking); }
  .type-nav { font-family: var(--font-family-body); font-weight: var(--font-weight-medium); font-size: var(--type-nav-size); line-height: var(--type-nav-line); letter-spacing: var(--type-nav-tracking); }
  .type-announcement { font-family: var(--font-family-heading); font-weight: var(--font-weight-regular); font-size: var(--type-announcement-size); line-height: var(--type-announcement-line); letter-spacing: var(--type-announcement-tracking); }
  .type-eyebrow { font-family: var(--font-family-body); font-weight: var(--font-weight-regular); font-size: var(--type-eyebrow-size); line-height: var(--type-eyebrow-line); letter-spacing: var(--type-eyebrow-tracking); }
  .type-eyebrow-small { font-family: var(--font-family-body); font-weight: var(--font-weight-medium); font-size: var(--type-eyebrow-small-size); line-height: var(--type-eyebrow-small-line); letter-spacing: var(--type-eyebrow-small-tracking); }
  .type-body-large { font-family: var(--font-family-body); font-weight: var(--font-weight-regular); font-size: var(--type-body-large-size); line-height: var(--type-body-large-line); letter-spacing: var(--type-body-large-tracking); }
  .type-body { font-family: var(--font-family-body); font-weight: var(--font-weight-regular); font-size: var(--type-body-size); line-height: var(--type-body-line); letter-spacing: var(--type-body-tracking); }
  .type-body-small { font-family: var(--font-family-body); font-weight: var(--font-weight-regular); font-size: var(--type-body-small-size); line-height: var(--type-body-small-line); letter-spacing: var(--type-body-small-tracking); }
  .type-caption { font-family: var(--font-family-body); font-weight: var(--font-weight-regular); font-size: var(--type-caption-size); line-height: var(--type-caption-line); letter-spacing: var(--type-caption-tracking); }
  .type-micro { font-family: var(--font-family-body); font-weight: var(--font-weight-regular); font-size: var(--type-micro-size); line-height: var(--type-micro-line); letter-spacing: var(--type-micro-tracking); }
{% endstyle %}
