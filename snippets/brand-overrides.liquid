{% doc %}
  Scoped style overrides for stock Horizon markup: buttons, announcement bar, header, marquee ticker, product information, sticky add to cart, footer and slideshow controls. Renders no markup.

  @example
  {% render 'brand-overrides' %}
{% enddoc %}

{% stylesheet %}
  html:root {
    --height-buy-buttons: var(--layout-button-large);
  }

  :is(.button, .button-secondary, .button-custom):not(.button-unstyled),
  button.shopify-payment-button__button--unbranded {
    --button-padding-block: var(--space-20);
    --button-padding-inline: var(--space-40);

    border-radius: var(--radius-none);
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-extrabold);
    font-size: var(--type-button-size);
    line-height: var(--type-button-line);
    letter-spacing: var(--type-button-tracking);
    text-transform: uppercase;
  }

  :is(.button, .button-secondary, .button-custom).button--medium {
    --button-padding-block: 0;
    --button-padding-inline: var(--space-20);

    min-block-size: var(--layout-button-medium);
  }

  :is(.button, .button-secondary, .button-custom).button--small {
    --button-padding-block: 0;
    --button-padding-inline: var(--space-14);

    min-block-size: var(--layout-button-small);
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-extrabold);
    font-size: var(--type-label-size);
    line-height: var(--type-button-line);
  }

  .button:not(.button-secondary, .button-unstyled):hover {
    --button-color: var(--color-primary-button-text);
    --button-background-color: var(--color-primary-button-background);
    --button-border-color: var(--color-primary-button-border);
  }

  .button-secondary:not(.button-unstyled):hover {
    --button-color: var(--color-secondary-button-text);
    --button-background-color: var(--color-secondary-button-background);
    --button-border-color: var(--color-secondary-button-border);
  }

  :is(.button, .button-secondary, .button-custom):not(.button-unstyled):hover {
    opacity: var(--opacity-brand-hover);
  }

  :is(.button, .button-secondary, .button-custom):not(.button-unstyled):active {
    opacity: var(--opacity-brand-pressed);
  }

  :is(.button, .button-secondary, .button-custom):not(.button-unstyled):is(:disabled, [aria-disabled='true']) {
    opacity: var(--opacity-brand-disabled);
  }

  :is(.button, .button-secondary, .button-custom):not(.button-unstyled):focus-visible {
    box-shadow: var(--effect-focus-ring), inset 0 0 0 var(--button-border-width) var(--button-border-color);
  }

  @media (prefers-reduced-motion: no-preference) {
    :is(.button, .button-secondary, .button-custom):not(.button-unstyled) {
      transition: opacity var(--duration-fast) var(--easing-standard),
        box-shadow var(--duration-fast) var(--easing-standard);
    }
  }

  .announcement-bar .announcement-bar__text {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-regular);
    font-size: var(--type-announcement-size);
    line-height: var(--type-announcement-line);
    letter-spacing: var(--type-announcement-tracking);
    text-transform: uppercase;
  }

  .announcement-bar .announcement-bar__slider {
    min-block-size: calc(var(--space-30) + var(--space-4));
  }

  .announcement-bar .announcement-bar__slider .slideshow-control {
    block-size: calc(var(--space-30) + var(--space-4));
  }

  .header .header__columns {
    --header-mobile-bookend: auto;
  }

  /* Mobile: equal side columns so the logo sits on the true centre (Figma 977:685 logo at x 110-280) */
  #header-component[data-menu-style='drawer'] .header__row--top .header__columns {
    --header-template-columns: minmax(0, 1fr) 0 auto 0 minmax(0, 1fr);
  }

  /* Announcement chevrons: none on mobile; on desktop the glyphs sit on the 30 page edge */
  @media screen and (max-width: 749px) {
    .announcement-bar .announcement-bar__slider slideshow-arrows {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .announcement-bar .announcement-bar__slider .slideshow-control--previous {
      margin-inline-start: calc(var(--space-10) + var(--space-2) / 2);
    }

    .announcement-bar .announcement-bar__slider .slideshow-control--next {
      margin-inline-end: calc(var(--space-10) + var(--space-2) / 2);
    }
  }

  .header .menu-list .menu-list__link {
    color: var(--menu-top-level-font-color);
  }

  .header .menu-list .menu-list__list-item:where(:hover, :focus-within) .menu-list__link-title {
    text-decoration: underline;
    text-underline-offset: var(--space-4);
  }

  .header header-actions {
    gap: var(--space-30);
  }

  @media screen and (max-width: 989px) {
    .header .header__row--top .header__columns {
      min-block-size: calc(var(--space-60) + var(--space-4));
    }

    #MainContent > .shopify-section:has(.breadcrumbs--desktop-only) {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    .header .header__row--top .header__columns {
      padding-block: calc(var(--space-14) / 2);
    }

    .header .menu-list__list-item:not([slot='overflow']) .menu-list__link-title {
      padding-inline: var(--space-24);
    }
  }

  .header :is(.search-action--text .header-actions__action > span:first-child, .header-actions__cart-icon--text > span:first-child, .account-button__text),
  .header details:not(.menu-open) > .header__icon--menu::after {
    border-inline: var(--border-strong) solid currentcolor;
    padding-inline: var(--space-8);
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-extrabold);
    font-size: var(--type-button-size);
    line-height: var(--type-button-line);
    text-transform: uppercase;
  }

  .header details:not(.menu-open) > .header__icon--menu::after {
    content: attr(aria-label);
  }

  .header .header__icon--menu .header-drawer-icon--open,
  .header .header-actions__cart-icon--text > .svg-wrapper {
    display: none;
  }

  .header .header-actions__cart-icon--text > .mobile\:hidden {
    display: inline !important;
  }

  .header .header-actions__cart-icon--text {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .header .header-actions__cart-icon--text .cart-bubble {
    position: relative;
    inset-block-start: 0;
  }

  @media screen and (max-width: 749px) {
    .header :is(.search-action--text, .header-actions--text .account-button) {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .header :is(.menu-list__link, .header-actions__text-style, .search-action--text .header-actions__action > span:first-child, .header-actions__cart-icon--text > span:first-child, .account-button__text) {
      font-family: var(--font-family-body);
      font-weight: var(--font-weight-medium);
      font-size: var(--type-nav-size);
      line-height: var(--type-nav-line);
      letter-spacing: var(--type-nav-tracking);
      text-transform: uppercase;
    }
  }

  marquee-component:not(:has(.marquee__repeated-items > :not(.text-block))) :is(.text-block, .text-block > *) {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-extrabold);
    font-size: var(--type-title-bold-size);
    line-height: var(--type-title-bold-line);
    letter-spacing: var(--type-title-bold-tracking);
    text-transform: uppercase;
  }

  marquee-component:not(:has(.marquee__repeated-items > :not(.text-block))) .text-block {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--marquee-gap);
  }

  @media screen and (min-width: 990px) {
    /* Figma: 30 between every header action, Search included (Search sits outside header-actions) */
    .header .search-action--text {
      margin-inline-end: var(--space-10);
    }

    /* Bracket bars are 16 high: the label's line box */
    .header :is(.search-action--text .header-actions__action > span:first-child, .header-actions__cart-icon--text > span:first-child, .account-button__text) {
      line-height: var(--space-16);
    }
  }

  /* Press marquee (stars + quotes, Figma 965:1254 strip): Sandstone 16/1.3 quotes, 30 from stars to quote, 50 from quote to the next stars */
  marquee-component:has(.marquee__repeated-items > :not(.text-block)) .text-block {
    margin-inline-end: var(--space-20);
    color: var(--color-on-media);
  }

  marquee-component:has(.marquee__repeated-items > :not(.text-block)) .text-block :is(p, span) {
    line-height: 1.3;
  }

  marquee-component:not(:has(.marquee__repeated-items > :not(.text-block))) .text-block::before {
    content: '|';
    content: '|' / '';
    color: var(--color-divider);
  }

  .product-information .slideshow-controls__thumbnails {
    gap: var(--space-10);
  }

  .product-information .slideshow-controls__thumbnails .slideshow-control {
    inline-size: calc(var(--space-60) + var(--space-14));
  }

  /* Media badge on the main gallery image (Figma: Sandstone chip at 12, 12, GT America 10 caps, Sepia) */
  .product-media__badge {
    position: absolute;
    inset-block-start: var(--space-12);
    inset-inline-start: var(--space-12);
    z-index: 1;
    padding: var(--space-2) var(--space-10);
    background: var(--color-background);
    color: var(--color-palette-sepia);
    text-transform: uppercase;
    pointer-events: none;
  }

  :is(.product-information, featured-product-information) slideshow-slide:has(> .product-media__badge) {
    position: relative;
  }

  /* Figma draws every thumbnail plain (no selected outline) and no arrows on the main image; the rail is the navigation */
  :is(.product-information, featured-product-information) .slideshow-controls__thumbnails .slideshow-control[aria-selected='true']:not(:focus-visible) {
    outline: none;
  }

  :is(.product-information, featured-product-information) .product-media-container slideshow-arrows,
  :is(.product-information, featured-product-information) media-gallery slideshow-arrows {
    display: none;
  }

  .product-information .slideshow-controls__thumbnails::before,
  .product-information .slideshow-controls__thumbnails::after {
    content: '';
    flex: 0 0 var(--space-10);
    align-self: stretch;
    background-color: var(--color-divider);
  }

  @media screen and (min-width: 750px) {
    .product-information slideshow-controls:is([pagination-position='left'], [pagination-position='right']) .slideshow-controls__thumbnails::before,
    .product-information slideshow-controls:is([pagination-position='left'], [pagination-position='right']) .slideshow-controls__thumbnails::after {
      flex-basis: var(--space-14);
    }
  }

  @media screen and (min-width: 990px) {
    .product-information__grid {
      --sidebar-width: calc(var(--layout-buy-box-width) + var(--gap) / 2);
    }

    .product-information slideshow-controls[thumbnails]:not([controls-on-media])[pagination-position] .slideshow-controls__thumbnails {
      padding-block: 0;
      padding-inline: 0 var(--space-10);
    }

    /* Desktop frames draw the rail's end bars in Tan (965:2033); the mobile frame uses Fossil */
    :is(.product-information, featured-product-information) .slideshow-controls__thumbnails::before,
    :is(.product-information, featured-product-information) .slideshow-controls__thumbnails::after {
      background-color: var(--color-accent-bar);
    }

    :is(.product-information, featured-product-information) .product-information__grid:not(.product-information__grid--half, .product-information--media-none).product-information--media-left {
      grid-template-columns: minmax(0, 1fr) max(var(--sidebar-width), calc(var(--sidebar-width) + (100% - var(--layout-content-width) + var(--space-80) * 6) * 0.75));
    }

    .product-information .slideshow-controls__thumbnails .slideshow-control {
      inline-size: var(--space-80);
    }
  }

  .product-details :is([ref='productTitleLink'] .text-block, [ref='productTitleLink'] .text-block > *, .text-block > h1) {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-extrabold);
    font-size: var(--type-h2-size);
    line-height: var(--type-h2-line);
    letter-spacing: var(--type-h2-tracking);
    text-transform: uppercase;
  }

  /* Buy-box rhythm: 16 between blocks on mobile, 24 on desktop (Figma 965:3468 / 965:2045).
     The template's --gap is inline, so the buy box carries its own variable. */
  .product-details .group-block-content:has(> .buy-buttons-block) {
    --buybox-gap: var(--space-16);

    gap: var(--buybox-gap);
  }

  @media screen and (min-width: 990px) {
    .product-details .group-block-content:has(> .buy-buttons-block) {
      --buybox-gap: var(--space-24);
    }
  }

  .product-details .product-rating + .text-block {
    margin-block-start: calc(var(--space-16) - var(--buybox-gap));
  }

  .product-details .text-block:has(> h1) + .text-block,
  .product-details .text-block + .product-highlights {
    margin-block-start: calc(var(--space-10) - var(--buybox-gap));
  }

  .product-details .text-block:has(> h1) + .text-block :is(p, li) {
    font-size: calc(var(--type-body-small-size) + var(--space-2));
    line-height: var(--type-body-line);
  }

  @media screen and (min-width: 990px) {
    .product-details .text-block:has(> h1) + .text-block,
    .product-details .text-block + .product-highlights {
      margin-block-start: calc(var(--space-20) - var(--buybox-gap));
    }
  }

  .product-details .buy-buttons-block + .text-block,
  .product-details .buy-buttons-block ~ .product__pickup-availabilities + .text-block {
    margin-block-start: calc(var(--space-10) - var(--buybox-gap));
  }

  .product-details .add-to-cart-icon {
    display: none;
  }

  .product-details .accordion .details {
    border-block-end: var(--border-hairline) solid var(--color-divider);
  }

  .product-details .accordion accordion-custom:first-child .details {
    border-block-start: var(--border-hairline) solid var(--color-divider);
  }

  .product-details .accordion .details__header {
    gap: var(--space-10);
    padding-block: var(--space-20);
    min-block-size: auto;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-medium);
    font-size: var(--type-h5-size);
    line-height: var(--type-h5-line);
    letter-spacing: var(--type-h5-tracking);
    text-transform: uppercase;
  }

  /* Figma accordion icon: 14 x 14, 2px bars, top-aligned with the row's 20 padding */
  .product-details .accordion .details__header {
    align-items: flex-start;
  }

  .product-details .accordion .details__header > .svg-wrapper {
    order: -1;
    margin: 0;
    inline-size: var(--space-14);
    block-size: var(--space-14);
  }

  .product-details .accordion .details__header > .svg-wrapper svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .product-details .accordion .details-content :is(.text-block, rte-formatter) > :last-child {
    margin-block-end: 0;
  }

  .product-details .accordion .details-content {
    padding-inline-start: var(--space-24);
    padding-block-end: var(--space-20);
  }

  .product-details .accordion details[open] > .details__header {
    padding-block-end: var(--space-12);
  }

  .product-details .accordion .details-content :is(.text-block, .text-block > *) {
    font-size: var(--type-body-small-size);
    line-height: var(--type-body-small-line);
  }

  .sticky-add-to-cart .sticky-add-to-cart__bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'image info'
      'image price'
      'plan plan'
      'button button';
    gap: var(--space-8) var(--space-12);
    padding: var(--space-10);
    padding-block-end: max(var(--space-10), var(--safe-area-inset-bottom, var(--space-10)));
    border-radius: var(--radius-none);
    background-color: var(--color-white);
    box-shadow: var(--effect-sticky-shadow);
  }

  .sticky-add-to-cart .sticky-add-to-cart__bar::before {
    display: none;
  }

  .sticky-add-to-cart .sticky-add-to-cart__image {
    grid-area: image;
    block-size: var(--space-80);
    border-radius: var(--radius-none);
  }

  .sticky-add-to-cart .sticky-add-to-cart__info {
    grid-area: info;
    align-self: end;
  }

  .sticky-add-to-cart .sticky-add-to-cart__title {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-extrabold);
    font-size: var(--type-title-bold-size);
    line-height: 1;
    text-transform: uppercase;
    white-space: normal;
  }

  .sticky-add-to-cart .sticky-add-to-cart__price {
    grid-area: price;
    align-self: start;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-medium);
    font-size: var(--type-h5-size);
    line-height: normal;
  }

  /* Sticky bar extras (Figma 965:1973 / 965:4237): rating row, plan price + savings tag, plan select */
  .sticky-add-to-cart .sticky-add-to-cart__rating {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin: 0 0 var(--space-6);
    color: var(--color-foreground);
  }

  .sticky-add-to-cart .sticky-add-to-cart__rating .star-rating {
    margin-inline-end: var(--space-2);
  }

  .sticky-add-to-cart .sticky-add-to-cart__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
  }

  .sticky-add-to-cart[data-has-plans] .sticky-add-to-cart__price > :not([data-sticky-plan-price], [data-sticky-plan-savings]) {
    display: none;
  }

  .sticky-add-to-cart .sticky-add-to-cart__savings {
    padding: var(--space-2) var(--space-10);
    background: var(--color-accent-bar);
    color: var(--color-background);
    text-transform: uppercase;
  }

  .sticky-add-to-cart .sticky-add-to-cart__plan {
    position: relative;
    grid-area: plan;
    display: block;
  }

  .sticky-add-to-cart .sticky-add-to-cart__plan[hidden] {
    display: none;
  }

  .sticky-add-to-cart .sticky-add-to-cart__plan::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: var(--space-14);
    inline-size: var(--space-6);
    block-size: var(--space-6);
    border-inline-end: var(--border-hairline) solid var(--color-foreground);
    border-block-end: var(--border-hairline) solid var(--color-foreground);
    translate: 0 -75%;
    rotate: 45deg;
    pointer-events: none;
  }

  .sticky-add-to-cart .sticky-add-to-cart__plan-select {
    inline-size: 100%;
    min-inline-size: calc(var(--space-112) * 2 + var(--space-6));
    padding: var(--space-12) calc(var(--space-14) * 2 + var(--space-8)) var(--space-12) var(--space-10);
    border: var(--border-hairline) solid var(--color-divider);
    border-radius: var(--radius-none);
    background: var(--color-white);
    color: var(--color-foreground);
    font-family: var(--font-family-body);
    font-size: var(--type-body-small-size);
    line-height: 1.3;
    appearance: none;
  }

  .sticky-add-to-cart .sticky-add-to-cart__button:not(:disabled, [data-added='true'])::after {
    content: var(--purchase-options-button-label, none);
  }

  .sticky-add-to-cart .sticky-add-to-cart__button {
    grid-area: button;
    inline-size: 100%;
    block-size: var(--layout-button-medium);
    margin-block-start: calc(var(--space-12) - var(--space-8));
    padding-block: 0;
  }

  .sticky-add-to-cart .sticky-add-to-cart__bar .add-to-cart-text__content {
    display: initial;
  }

  .sticky-add-to-cart .sticky-add-to-cart__button .add-to-cart-text > .svg-wrapper {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .sticky-add-to-cart .sticky-add-to-cart__bar {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      grid-template-areas:
        'image info plan button'
        'image price plan button';
      column-gap: var(--space-12);
      inline-size: min(calc(100% - var(--layout-gutter) * 2), var(--layout-content-width));
      padding: var(--space-30);
    }

    .sticky-add-to-cart .sticky-add-to-cart__plan {
      align-self: center;
      margin-inline: var(--space-80) var(--space-8);
    }

    .sticky-add-to-cart .sticky-add-to-cart__button {
      align-self: center;
      inline-size: auto;
      min-inline-size: calc(var(--space-112) * 2 + var(--space-40) + 0.1875rem);
      margin-block-start: 0;
      padding-inline: var(--space-40);
    }
  }

  footer .menu .menu__heading.menu__heading {
    opacity: var(--opacity-brand-muted);
    font-family: var(--font-family-body);
    font-weight: var(--font-weight-medium);
    font-size: var(--type-eyebrow-small-size);
    line-height: var(--type-eyebrow-small-line);
    letter-spacing: var(--type-eyebrow-small-tracking);
    text-transform: uppercase;
  }

  footer .menu .menu__heading.menu__heading > * {
    font-weight: inherit;
    font-size: inherit;
  }

  footer .menu .details-content a {
    font-size: calc(var(--type-body-small-size) + var(--space-2));
    line-height: var(--type-body-line);
  }

  footer .menu summary.menu__heading.menu__heading {
    padding-block: 0;
  }

  footer .menu .menu__details > .details-content {
    margin-block-start: var(--space-20);
  }

  footer .email-signup__input-group--underline {
    align-items: flex-start;
  }

  footer .email-signup__input-group--underline .email-signup__input {
    block-size: calc(var(--space-30) + var(--space-6));
    padding-block: 0 var(--space-6);
  }

  footer .email-signup-block + .text-block {
    margin-block-start: calc(var(--space-14) - var(--gap));
  }

  @media screen and (max-width: 749px) {
    footer .footer-content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-16);
    }

    footer .footer-content > .group-block {
      grid-column: 1 / -1;
      margin-block-end: calc(var(--space-40) - var(--space-16));
    }

    footer .footer-content > jumbo-text {
      margin-block-start: calc(var(--jumbo-bar-width) + var(--space-30) - var(--space-16));
    }

    footer .utilities {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      padding-block: var(--space-30) var(--space-24);
    }

    footer .utilities > * {
      text-align: start;
    }
  }

  /* Footer type (Figma 966:754): "Join the community" 18/1, consent 12/normal, tagline Akzidenz Medium, placeholder 14 Sandstone */
  footer .footer-content > .group-block .text-block:first-child :is(p, h2, h3) {
    line-height: 1;
  }

  footer .email-signup-block + .text-block :is(p) {
    line-height: normal;
  }

  footer .footer-content > .group-block .text-block:last-child :is(p) {
    font-weight: var(--font-weight-medium);
    line-height: normal;
  }

  footer .email-signup__input::placeholder {
    opacity: 1;
    color: currentColor;
    font-size: var(--type-body-small-size);
  }

  /* Bottom row: four items in Sandstone at full strength, spread across the row (2 x 2 on mobile) */
  footer .utilities {
    --color-utilities: var(--color-foreground);
  }

  footer .utilities .text-block a,
  footer .utilities .footer-utilities__text a {
    color: inherit;
    text-decoration: none;
  }

  footer .utilities--blocks-4 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12) var(--space-16);
  }

  footer .utilities--blocks-4 > :nth-child(even) {
    text-align: end;
  }

  @media screen and (min-width: 990px) {
    footer .utilities--blocks-4 {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
    }

    footer .utilities--blocks-4 > :nth-child(even) {
      text-align: start;
    }

    /* Newsletter 380 at the left, three 260 link columns ending on the right edge (x 598 / 874 / 1150 at 1440) */
    footer .footer-content.footer-content {
      grid-template-columns: minmax(0, 380fr) minmax(0, 156fr) repeat(3, minmax(0, 260fr));
      column-gap: var(--space-16);
    }

    footer .footer-content > .group-block {
      grid-column: 1;
    }

    footer .footer-content > .group-block + * {
      grid-column: 3;
    }
  }

  footer .email-signup__input--underline + .email-signup__button.email-signup__button--text {
    min-block-size: var(--space-30);
    padding-block: 0;
    padding-inline: var(--space-16);
  }

  footer jumbo-text {
    --jumbo-bar-width: var(--icon-bar-mobile);
    --jumbo-bar-offset: calc(var(--jumbo-bar-width) + var(--space-24));

    position: relative;
    grid-column: 1 / -1;
    justify-self: stretch;
    inline-size: auto;
    margin-inline: var(--jumbo-bar-offset);
    margin-block: var(--jumbo-bar-width);
  }

  footer jumbo-text::before,
  footer jumbo-text::after {
    content: '';
    position: absolute;
    inset-block: calc(var(--jumbo-bar-width) * -1);
    inline-size: var(--jumbo-bar-width);
    background-color: currentcolor;
  }

  footer jumbo-text::before {
    inset-inline-start: calc(var(--jumbo-bar-offset) * -1);
  }

  footer jumbo-text::after {
    inset-inline-end: calc(var(--jumbo-bar-offset) * -1);
  }

  @media screen and (min-width: 990px) {
    footer jumbo-text {
      --jumbo-bar-width: calc(var(--space-40) + var(--space-6));
      --jumbo-bar-offset: calc(var(--jumbo-bar-width) + var(--space-80) + var(--space-14));
    }
  }

  /* Horizon blends dot controls with `difference`, which turned the tan dots blue-grey on light backgrounds.
     Same specificity as Horizon's rule but Horizon loads later, hence the extra `slideshow-component`. */
  slideshow-component slideshow-controls:has(.slideshow-controls__dots),
  slideshow-component[autoplay] slideshow-controls {
    mix-blend-mode: normal;
  }

  /* Figma: 6px square dots, 6px apart (12 centre to centre). Targets are 12 wide and 24 tall so the spacing holds */
  slideshow-controls .slideshow-controls__dots {
    gap: 0;
  }

  slideshow-controls .slideshow-controls__dots button {
    --size: var(--space-6);
    --color: color-mix(in srgb, var(--color-accent-bar) calc(var(--opacity-brand-inactive) * 100%), transparent);
    --color-active: var(--color-accent-bar);
    --color-hover: var(--color-accent-bar);

    min-inline-size: var(--space-12);
    inline-size: var(--space-12);
    min-block-size: var(--space-24);
    margin: 0;
    padding: 0;
    display: grid;
    place-items: center;
  }

  slideshow-controls .slideshow-controls__dots button::after {
    border-radius: var(--radius-none);
    box-shadow: none;
  }

  slideshow-controls .slideshow-controls__arrows .slideshow-control {
    color: var(--color-foreground);
  }

  slideshow-controls .slideshow-controls__arrows .icon {
    inline-size: var(--icon-md);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    :is(.product-information, featured-product-information) .product-information__grid:not(.product-information--media-none).product-information--media-left {
      grid-template-columns: 100%;
    }

    :is(.product-information, featured-product-information) .product-information__grid:not(.product-information--media-none) :is(.product-information__media, .product-details) {
      grid-column: 1;
      padding-inline: 0;
    }
  }

  footer .section {
    background-color: var(--color-background);
  }

  body:is(.page-width-wide, .page-width-normal, .page-width-narrow, .page-width-content) {
    --page-margin: var(--layout-gutter);
    --page-content-width: var(--layout-content-width);
  }

  #MainContent > .shopify-section + .shopify-section,
  footer > .shopify-section:first-child {
    margin-block-start: var(--layout-section-gap);
  }

  #MainContent > .shopify-section + .shopify-section:has(marquee-component),
  #MainContent > .shopify-section:has(.breadcrumbs) + .shopify-section.shopify-section {
    margin-block-start: 0;
  }

  :is(h1, h2, h3, h4, .type-display, .type-h1, .type-h2, .type-h3, .type-card-label, .type-title-bold) {
    text-wrap: balance;
  }

  :is(p, li, .rte) {
    text-wrap: pretty;
  }

  /* Judge.me review widget (minimal-header layout) restyled to the Figma reviews block (965:2002).
     The sidebar, histogram, search and Q&A tabs are Judge.me layout settings (plan D-19). */
  #judgeme_product_reviews .jm-review-widget {
    --jm-review-widget-text-color: var(--color-foreground);
    --jm-review-widget-lighter-text-color: var(--color-palette-sepia);
    --jm-review-widget-star-and-histogram-color: var(--color-rating);
    --jm-review-widget-button-color: var(--color-foreground);
    --jm-review-widget-button-text-color: var(--color-background);
    --jm-btn-border-radius: 0;
    --jm-widget-border-radius: 0;
    --jm-widget-border-radius-simplified: 0;
    --jm-input-border-radius: 0;
    --jm-tabs-border-radius: 0;
    --jm-tag-bg: var(--color-foreground);
    --jm-tag-color: var(--color-background);
    --jm-center-max: none;
    --jm-center-gutters: 0;

    padding-block-start: var(--space-16);
    color: var(--color-foreground);
    font-family: var(--font-family-body);
  }

  #judgeme_product_reviews .jm-review-widget-minimal-header__title {
    display: none;
  }

  #judgeme_product_reviews .jm-average-rating-display .jm-text {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-medium);
    font-size: calc(var(--space-16) + var(--space-2));
    color: var(--color-foreground);
  }

  #judgeme_product_reviews .jm-button--primary {
    min-block-size: var(--layout-button-large);
    min-inline-size: min(100%, calc(var(--space-112) * 4 - var(--space-8)));
    padding-inline: var(--space-40);
    border-radius: var(--radius-none);
    background: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-extrabold);
    font-size: var(--type-button-size);
    line-height: var(--type-button-line);
    text-transform: uppercase;
  }

  #judgeme_product_reviews .jm-button--secondary,
  #judgeme_product_reviews .jm-sort-filter :is(select, button) {
    border: var(--border-hairline) solid var(--color-divider);
    border-radius: var(--radius-none);
    background: var(--color-white);
    color: var(--color-foreground);
  }

  #judgeme_product_reviews .jm-star-rating {
    gap: var(--space-6);
  }

  #judgeme_product_reviews .jm-star-rating svg {
    inline-size: var(--space-16);
    block-size: var(--space-16);
  }

  #judgeme_product_reviews .jm-review-item {
    padding-block: var(--space-24);
    border-block-end: var(--border-hairline) solid var(--color-divider);
    color: var(--color-foreground);
  }

  #judgeme_product_reviews .jm-reviewer-avatar {
    inline-size: var(--space-60);
    block-size: var(--space-60);
    border-radius: var(--radius-none);
    background: var(--color-palette-linen);
  }

  #judgeme_product_reviews .jm-reviewer-info__details > :first-child {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-medium);
    font-size: calc(var(--space-16) + var(--space-2));
    color: var(--color-foreground);
  }

  #judgeme_product_reviews .jm-reviewer-info__details :is(.jm-tag, [class*='verified']) {
    padding: var(--space-2) var(--space-6);
    border: 0;
    border-radius: var(--radius-none);
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: var(--type-caption-size);
  }

  #judgeme_product_reviews .jm-review-content {
    color: var(--color-foreground);
    line-height: 1.3;
  }

  /* K6: the 24 x 14 Figma arrow, drawn edge to edge (its wrapper is 20 square in Horizon) */
  :is(slideshow-arrows, slideshow-controls) .slideshow-control :is(svg, .icon, .svg-wrapper) {
    inline-size: var(--icon-md);
    block-size: auto;
  }

  :is(slideshow-arrows, slideshow-controls) .slideshow-control:disabled {
    opacity: var(--opacity-brand-disabled);
  }

  featured-product-information .product-details {
    align-self: center;
  }

  /* Home featured product (Figma 965:1385 / mobile frame): title to description 15; mobile image 845:633, 20 from thumbnails to title */
  featured-product-information .product-details .text-block:has(> h1) + .text-block {
    margin-block-start: calc(var(--space-14) + 0.0625rem - var(--buybox-gap, var(--gap)));
  }

  @media screen and (max-width: 989px) {
    /* The block writes --gallery-aspect-ratio inline on media-gallery; only !important overrides an inline custom property */
    featured-product-information media-gallery {
      --gallery-aspect-ratio: 845 / 633 !important;
    }

    featured-product-information .product-details {
      padding-block-start: calc(var(--space-20) - var(--space-10));
    }
  }

  /* Desktop split from the home frame: 80 rail + 10 + 700 image, 34 gap, 556 buy box (scales with the content width) */
  @media screen and (min-width: 990px) {
    featured-product-information .product-information__grid.product-information__grid:not(.product-information__grid--half, .product-information--media-none).product-information--media-left {
      grid-template-columns: minmax(0, 790fr) minmax(0, 556fr);
      column-gap: calc(var(--space-30) + var(--space-4));
    }
  }

  #MainContent > .shopify-section:not(:has(> *)) {
    display: none;
  }

  @media screen and (min-width: 1441px) {
    :is(.product-information, featured-product-information) .product-information__grid .product-details > * {
      max-inline-size: calc(var(--layout-text-width) + var(--space-80));
    }
  }

  @media screen and (min-width: 990px) {
    header .mega-menu__grid:has(.mega-menu__content-list--products) {
      display: flex;
      justify-content: center;
      align-items: stretch;
      gap: var(--space-40);
      padding-block: var(--space-10) var(--space-20);
    }

    header .mega-menu__grid:has(.mega-menu__content-list--products) .mega-menu__list {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-16);
      grid-column: auto;
      padding-inline-end: var(--space-40);
      border-inline-end: var(--border-hairline) solid var(--color-divider);
    }

    header .mega-menu__grid:has(.mega-menu__content-list--products) .mega-menu__column {
      grid-column: auto;
    }

    header .mega-menu__grid:has(.mega-menu__content-list--products) .mega-menu__content {
      grid-column: auto;
    }

    header .mega-menu__content-list--products {
      grid-template-columns: repeat(var(--menu-content-columns-desktop), calc(var(--space-112) * 2));
      justify-content: start;
      gap: var(--space-20);
    }
  }
{% endstylesheet %}
